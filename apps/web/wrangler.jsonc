{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gtrz-web",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
