---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Turnstile from '@/components/Turnstile.astro';
import { getHomePage } from '@/lib/cms';
import { getPublicCopy } from '@/lib/public-copy';
import type { Locale } from '@/lib/cms';
const locale: Locale = Astro.url.searchParams.get('lang') === 'es' ? 'es' : 'pt-BR';
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const site=await getHomePage();
const c=getPublicCopy(site.settings,locale,'partnershipPage');
---
<SiteLayout locale={locale} title={c.seoTitle} settings={site.settings}>
  <main class="form-page">
    <section class="form-hero" data-section="partnership_intro">
      <div class="shell">
        <span class="eyebrow">{c.eyebrow}</span>
        <h1>{c.title}</h1>
        <p>{c.intro}</p>
      </div>
    </section>
    <section class="paper-section" data-section="partnership_form">
      <div class="shell form-shell">
        <form data-public-form="partnerships">
          <div class="form-grid-public">
            <label><span>{c.contactNameLabel}</span><input name="contactName" required maxlength="160" /></label>
            <label><span>{c.companyNameLabel}</span><input name="companyName" /></label>
            <label><span>{c.typeLabel}</span><select name="partnershipType" required><option value="">{c.typePlaceholder}</option><option value="venue">{c.venueOption}</option><option value="brand">{c.brandOption}</option><option value="artist">{c.artistOption}</option><option value="supplier">{c.supplierOption}</option><option value="other">{c.otherOption}</option></select></label>
            <label><span>{c.cityLabel}</span><input name="city" /></label>
            <label><span>{c.emailLabel}</span><input name="email" type="email" /></label>
            <label><span>{c.whatsappLabel}</span><input name="whatsapp" /></label>
            <label class="wide"><span>{c.messageLabel}</span><textarea name="message" required></textarea></label>
          </div>
          <Turnstile action="partnership" />
          <div class="form-submit"><p data-form-message></p><button class="button primary" type="submit">{c.submitLabel}</button></div>
        </form>
      </div>
    </section>
  </main>
  <script define:vars={{ apiBase, successMessage:c.successMessage, errorMessage:c.errorMessage }}>
    const form = document.querySelector('[data-public-form="partnerships"]');
    const msg = form?.querySelector('[data-form-message]');
    let started = false;
    form?.addEventListener('focusin', () => {
      if (!started) { started = true; window.gtrzTrack?.('partnership_form_start', { section:'partnership_form' }); }
    });
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = Object.fromEntries(new FormData(form).entries());
      payload.turnstileToken = payload['cf-turnstile-response'] || undefined;
      delete payload['cf-turnstile-response'];
      try {
        const r = await fetch(`${apiBase}/api/public/partnerships`, { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify(payload) });
        if (!r.ok) throw new Error();
        window.gtrzTrack?.('partnership_form_submit', { section:'partnership_form' });
        if (msg) msg.textContent = successMessage;
        form.reset();
      } catch {
        if (msg) msg.textContent = errorMessage;
      }
    });
  </script>
</SiteLayout>
