---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Turnstile from '@/components/Turnstile.astro';
import { getHomePage } from '@/lib/cms';
import type { Locale } from '@/lib/cms';

const locale: Locale = Astro.url.searchParams.get('lang') === 'es' ? 'es' : 'pt-BR';
const es = locale === 'es';
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const site = await getHomePage();
const partnershipConfig = (site.settings as any)?.partnership || {};
const defaultPartnerTypes=['LOCAL / CASA / BAR / BOATE','MARCA','EMPRESA','FORNECEDOR','PRODUTORA / PROJETO','ARTISTA / AGÊNCIA','IMPRENSA / MÍDIA','OUTRO'];
const defaultProposalTypes=['PATROCÍNIO','APOIO','LOCAÇÃO DE ESPAÇO','REALIZAÇÃO DE EVENTO','CO-PRODUÇÃO','FORNECIMENTO DE PRODUTO','FORNECIMENTO DE SERVIÇO','AÇÃO DE MARCA','DIVULGAÇÃO / MÍDIA','PERMUTA','CONTRATAÇÃO DA GTRZ','OUTRO'];
const partnerTypes=Array.isArray(partnershipConfig.partnerTypes)&&partnershipConfig.partnerTypes.length?partnershipConfig.partnerTypes:defaultPartnerTypes;
const proposalTypes=Array.isArray(partnershipConfig.proposalTypes)&&partnershipConfig.proposalTypes.length?partnershipConfig.proposalTypes:defaultProposalTypes;
const privacyNoticeVersion='1.0';
const copy=es?{
  eyebrow:'GTRZ · ALIANZAS',title:'CONSTRUYAMOS JUNTOS.',intro:'Marcas, espacios, empresas, proveedores, proyectos y profesionales pueden registrar aquí una oportunidad comercial para análisis del equipo GTRZ.',
  partner:'TIPO DE SOCIO',partnerHelp:'SELECCIONA QUIÉN ESTÁ HABLANDO CON GTRZ.',contact:'RESPONSABLE DEL CONTACTO',organization:'ORGANIZACIÓN / OPERACIÓN',proposal:'LA PROPUESTA',materials:'MATERIALES',privacy:'PRIVACIDAD Y DATOS',
  tradeName:'NOMBRE DE LA ORGANIZACIÓN / PROYECTO',legalName:'RAZÓN SOCIAL · OPCIONAL',taxId:'CNPJ / CPF · OPCIONAL',segment:'SEGMENTO / ÁREA',website:'SITIO WEB · OPCIONAL',instagram:'INSTAGRAM · OPCIONAL',capacity:'CAPACIDAD DEL ESPACIO · OPCIONAL',serviceType:'TIPO DE SERVICIO',serviceArea:'ÁREA DE ACTUACIÓN',
  name:'NOMBRE COMPLETO',role:'CARGO / FUNCIÓN',whatsapp:'WHATSAPP',email:'E-MAIL',
  cep:'CEP',state:'ESTADO',city:'CIUDAD',neighborhood:'BARRIO',street:'CALLE / DIRECCIÓN',number:'NÚMERO',complement:'COMPLEMENTO · OPCIONAL',cepHint:'PARA ESPACIOS, EL CEP COMPLETA AUTOMÁTICAMENTE LA MAYOR PARTE DE LA DIRECCIÓN.',
  proposalTypes:'TIPOS DE ALIANZA',proposalHelp:'PUEDES MARCAR MÁS DE UNA OPCIÓN.',otherProposal:'DESCRIBE EL OTRO TIPO DE ALIANZA',proposalTitle:'TÍTULO DE LA PROPUESTA',summary:'RESUME LA IDEA',offer:'¿QUÉ OFRECES?',expect:'¿QUÉ ESPERAS DE GTRZ?',investment:'¿EXISTE INVERSIÓN FINANCIERA?',value:'VALOR ESTIMADO · OPCIONAL',period:'HAY FECHA O PERÍODO PREVISTO',start:'INICIO',end:'FIN',
  pdf:'PRESENTACIÓN / MEDIA KIT / PROPUESTA EN PDF · OPCIONAL',link:'LINK DE PRESENTACIÓN · OPCIONAL',observations:'OBSERVACIONES · OPCIONAL',
  privacyText:'Los datos informados serán tratados por GTRZ para analizar la propuesta, identificar y contactar al responsable, conducir negociaciones, mantener el historial de la relación comercial y, cuando corresponda, formalizar la alianza. GTRZ no comercializará estos datos ni los utilizará para finalidades incompatibles con esta relación.',privacyCheck:'DECLARO QUE LEÍ Y COMPRENDÍ EL AVISO DE PRIVACIDAD Y AUTORIZO EL TRATAMIENTO DE LOS DATOS INFORMADOS PARA ANÁLISIS Y CONTACTO SOBRE ESTA PROPUESTA.',privacyLink:'LEER POLÍTICA DE PRIVACIDAD PARA ALIANZAS',
  submit:'REGISTRAR PROPUESTA Y CONTINUAR EN WHATSAPP',choose:'SELECCIONA',loading:'CARGANDO…',cepFound:'DIRECCIÓN ENCONTRADA. REVISA LOS DATOS.',cepNotFound:'NO FUE POSIBLE LOCALIZAR ESTE CEP. COMPLETA LA DIRECCIÓN MANUALMENTE.',errorTitle:'REVISA LA PROPUESTA',errorIntro:'CORRIGE LOS SIGUIENTES PUNTOS ANTES DE CONTINUAR:',close:'ENTENDIDO',success:'PROPUESTA REGISTRADA. ABRIENDO WHATSAPP…'
}:{
  eyebrow:'GTRZ · PARCERIAS',title:'VAMOS CONSTRUIR JUNTOS.',intro:'Marcas, espaços, empresas, fornecedores, projetos e profissionais podem cadastrar aqui uma oportunidade comercial para análise da equipe GTRZ.',
  partner:'TIPO DE PARCEIRO',partnerHelp:'SELECIONE QUEM ESTÁ FALANDO COM A GTRZ.',contact:'RESPONSÁVEL PELO CONTATO',organization:'ORGANIZAÇÃO / OPERAÇÃO',proposal:'A PROPOSTA',materials:'MATERIAIS',privacy:'PRIVACIDADE E DADOS',
  tradeName:'NOME DA ORGANIZAÇÃO / PROJETO',legalName:'RAZÃO SOCIAL · OPCIONAL',taxId:'CNPJ / CPF · OPCIONAL',segment:'SEGMENTO / ÁREA',website:'SITE · OPCIONAL',instagram:'INSTAGRAM · OPCIONAL',capacity:'CAPACIDADE DO LOCAL · OPCIONAL',serviceType:'TIPO DE SERVIÇO',serviceArea:'ÁREA DE ATUAÇÃO',
  name:'NOME COMPLETO',role:'CARGO / FUNÇÃO',whatsapp:'WHATSAPP',email:'E-MAIL',
  cep:'CEP',state:'ESTADO',city:'CIDADE',neighborhood:'BAIRRO',street:'RUA / LOGRADOURO',number:'NÚMERO',complement:'COMPLEMENTO · OPCIONAL',cepHint:'PARA LOCAIS, O CEP PREENCHE AUTOMATICAMENTE A MAIOR PARTE DO ENDEREÇO.',
  proposalTypes:'TIPOS DE PARCERIA',proposalHelp:'VOCÊ PODE MARCAR MAIS DE UMA OPÇÃO.',otherProposal:'DESCREVA O OUTRO TIPO DE PARCERIA',proposalTitle:'TÍTULO DA PROPOSTA',summary:'RESUMA A IDEIA',offer:'O QUE VOCÊ OFERECE?',expect:'O QUE ESPERA DA GTRZ?',investment:'EXISTE INVESTIMENTO FINANCEIRO?',value:'VALOR ESTIMADO · OPCIONAL',period:'EXISTE DATA OU PERÍODO PREVISTO',start:'INÍCIO',end:'FIM',
  pdf:'APRESENTAÇÃO / MÍDIA KIT / PROPOSTA EM PDF · OPCIONAL',link:'LINK DE APRESENTAÇÃO · OPCIONAL',observations:'OBSERVAÇÕES · OPCIONAL',
  privacyText:'Os dados informados serão tratados pela GTRZ para análise da proposta apresentada, identificação e contato com o responsável, condução de negociações, manutenção do histórico de relacionamento comercial e, quando aplicável, formalização da parceria. A GTRZ não comercializará esses dados nem os utilizará para finalidades incompatíveis com essa relação.',privacyCheck:'DECLARO QUE LI E COMPREENDI O AVISO DE PRIVACIDADE E AUTORIZO O TRATAMENTO DOS DADOS INFORMADOS PARA ANÁLISE E CONTATO SOBRE ESTA PROPOSTA.',privacyLink:'LER POLÍTICA DE PRIVACIDADE PARA PARCERIAS',
  submit:'CADASTRAR PROPOSTA E CONTINUAR NO WHATSAPP',choose:'SELECIONE',loading:'CARREGANDO…',cepFound:'ENDEREÇO ENCONTRADO. CONFIRA OS DADOS.',cepNotFound:'NÃO FOI POSSÍVEL LOCALIZAR ESTE CEP. PREENCHA O ENDEREÇO MANUALMENTE.',errorTitle:'REVISE A PROPOSTA',errorIntro:'CORRIJA OS ITENS ABAIXO ANTES DE CONTINUAR:',close:'ENTENDI',success:'PROPOSTA CADASTRADA. ABRINDO O WHATSAPP…'
};
---
<SiteLayout locale={locale} title={es?'Alianzas · GTRZ':'Parcerias · GTRZ'} settings={site.settings}>
<main class="partner-page">
  <section class="partner-hero"><div class="shell hero-grid"><div><span class="eyebrow">{copy.eyebrow}</span><h1>{copy.title}</h1></div><p>{copy.intro}</p></div></section>
  <section class="partner-form-section"><div class="shell partner-shell">
    <form data-public-form="partnerships" novalidate>
      <fieldset class="partner-block"><legend><span>01</span>{copy.partner}</legend><p class="block-help">{copy.partnerHelp}</p><div class="choice-grid partner-choice-grid">{partnerTypes.map((type:string)=><label class="choice"><input type="radio" name="partnerType" value={String(type).toLocaleUpperCase('pt-BR')} /><span>{String(type).toLocaleUpperCase('pt-BR')}</span></label>)}</div></fieldset>

      <fieldset class="partner-block"><legend><span>02</span>{copy.contact}</legend><div class="form-grid"><label><span>{copy.name} *</span><input name="contactName" required maxlength="160" data-person-name data-upper autocomplete="name" /></label><label><span>{copy.role} *</span><input name="contactRole" required maxlength="120" data-upper /></label><label><span>{copy.whatsapp} *</span><input name="whatsapp" required inputmode="tel" maxlength="13" placeholder="81 90000-0000" data-phone autocomplete="tel" /></label><label><span>{copy.email} *</span><input name="email" type="email" required maxlength="200" placeholder="NOME@EMAIL.COM" data-email autocomplete="email" /></label></div></fieldset>

      <fieldset class="partner-block"><legend><span>03</span>{copy.organization}</legend><div class="form-grid"><label><span>{copy.tradeName} *</span><input name="tradeName" required maxlength="180" data-upper /></label><label><span>{copy.legalName}</span><input name="legalName" maxlength="200" data-upper /></label><label><span>{copy.taxId}</span><input name="taxId" inputmode="numeric" maxlength="18" data-tax-id placeholder="00.000.000/0000-00" /></label><label><span>{copy.segment} *</span><input name="segment" required maxlength="120" data-upper /></label><label><span>{copy.website}</span><input name="websiteUrl" type="url" maxlength="1000" placeholder="HTTPS://" /></label><label><span>{copy.instagram}</span><input name="instagramUrl" maxlength="200" placeholder="@" /></label><label class="conditional local-only" hidden><span>{copy.capacity}</span><input name="venueCapacity" inputmode="numeric" maxlength="7" /></label><label class="conditional supplier-only" hidden><span>{copy.serviceType} *</span><input name="serviceType" maxlength="160" data-upper /></label><label class="conditional supplier-only" hidden><span>{copy.serviceArea} *</span><input name="serviceArea" maxlength="160" data-upper /></label></div>
      <div class="location-shell"><p class="block-help address-help">{copy.cepHint}</p><div class="form-grid three"><label class="conditional local-only" hidden><span>{copy.cep} *</span><input name="postalCode" inputmode="numeric" maxlength="9" placeholder="00000-000" data-cep autocomplete="postal-code" /></label><label><span>{copy.state} *</span><select name="state" required data-state><option value="">{copy.loading}</option></select></label><label><span>{copy.city} *</span><select name="city" required data-city disabled><option value="">{copy.choose}</option></select></label><label class="conditional local-only" hidden><span>{copy.neighborhood} *</span><input name="neighborhood" maxlength="120" data-upper /></label><label class="conditional local-only span-two" hidden><span>{copy.street} *</span><input name="street" maxlength="180" data-upper /></label><label class="conditional local-only" hidden><span>{copy.number} *</span><input name="addressNumber" maxlength="30" data-upper /></label><label class="conditional local-only span-two" hidden><span>{copy.complement}</span><input name="complement" maxlength="160" data-upper /></label></div><p class="cep-status" data-cep-status aria-live="polite"></p></div></fieldset>

      <fieldset class="partner-block"><legend><span>04</span>{copy.proposal}</legend><p class="block-help">{copy.proposalHelp}</p><div class="choice-grid proposal-choice-grid">{proposalTypes.map((type:string)=><label class="choice"><input type="checkbox" name="proposalTypes" value={String(type).toLocaleUpperCase('pt-BR')} /><span>{String(type).toLocaleUpperCase('pt-BR')}</span></label>)}</div><label class="other-proposal" hidden data-other-proposal><span>{copy.otherProposal} *</span><input name="otherProposalType" maxlength="180" data-upper /></label><div class="form-grid proposal-fields"><label class="wide"><span>{copy.proposalTitle} *</span><input name="proposalTitle" required maxlength="180" data-upper /></label><label class="wide"><span>{copy.summary} *</span><textarea name="message" required maxlength="1200" rows="4" data-upper></textarea></label><label><span>{copy.offer} *</span><textarea name="offerText" required maxlength="1200" rows="5" data-upper></textarea></label><label><span>{copy.expect} *</span><textarea name="expectationText" required maxlength="1200" rows="5" data-upper></textarea></label><label><span>{copy.investment} *</span><select name="investmentStatus" required><option value="">{copy.choose}</option><option value="SIM">SIM</option><option value="NÃO">NÃO</option><option value="A DEFINIR">A DEFINIR</option></select></label><label class="investment-value" hidden><span>{copy.value}</span><input name="investmentValue" inputmode="decimal" maxlength="20" placeholder="R$ 0,00" /></label></div><label class="period-toggle"><input type="checkbox" data-period-toggle /><span>{copy.period}</span></label><div class="form-grid period-fields" hidden><label><span>{copy.start}</span><input name="startsAt" type="date" /></label><label><span>{copy.end}</span><input name="endsAt" type="date" /></label></div></fieldset>

      <fieldset class="partner-block"><legend><span>05</span>{copy.materials}</legend><div class="form-grid"><label class="file-field"><span>{copy.pdf}</span><input name="proposalFile" type="file" accept="application/pdf,.pdf" /><small>PDF · MÁX. 10 MB</small></label><label><span>{copy.link}</span><input name="presentationUrl" type="url" maxlength="1000" placeholder="HTTPS://" /></label><label class="wide observation-wrap"><span>{copy.observations}</span><textarea name="observations" maxlength="1000" rows="5" data-upper data-observations></textarea><small class="char-count"><b data-observation-count>0</b> / 1000</small></label></div></fieldset>

      <fieldset class="partner-block privacy-block"><legend><span>06</span>{copy.privacy}</legend><p class="privacy-copy">{copy.privacyText}</p><a class="privacy-link" href={`/privacidade-parcerias?lang=${es?'es':'pt-BR'}`} target="_blank" rel="noreferrer">{copy.privacyLink}</a><label class="privacy-consent"><input type="checkbox" name="privacyAccepted" value="1" data-privacy-consent /><span>{copy.privacyCheck}</span></label><input type="hidden" name="privacyNoticeVersion" value={privacyNoticeVersion}/><input type="hidden" name="privacyNoticeLocale" value={es?'es':'pt-BR'}/></fieldset>
      <Turnstile action="partnership" />
      <div class="form-submit"><p data-form-message aria-live="polite"></p><button class="button primary" type="submit">{copy.submit}</button></div>
    </form>
  </div></section>
</main>
<div class="form-modal" hidden data-error-modal role="dialog" aria-modal="true"><button class="form-modal-backdrop" type="button" aria-label={copy.close} data-modal-close></button><div class="form-modal-card"><div class="form-modal-mark">!</div><h2>{copy.errorTitle}</h2><p>{copy.errorIntro}</p><ul data-modal-errors></ul><button class="button primary" type="button" data-modal-close>{copy.close}</button></div></div>
<script is:inline define:vars={{apiBase,copy,es,privacyNoticeVersion}}>
const form=document.querySelector('[data-public-form="partnerships"]');const msg=form?.querySelector('[data-form-message]');const stateSelect=form?.querySelector('[data-state]');const citySelect=form?.querySelector('[data-city]');const cepInput=form?.querySelector('[data-cep]');const cepStatus=form?.querySelector('[data-cep-status]');const nameInput=form?.querySelector('[data-person-name]');const phoneInput=form?.querySelector('[data-phone]');const taxInput=form?.querySelector('[data-tax-id]');const obs=form?.querySelector('[data-observations]');const obsCount=form?.querySelector('[data-observation-count]');const otherWrap=form?.querySelector('[data-other-proposal]');const otherInput=form?.querySelector('[name="otherProposalType"]');const investment=form?.querySelector('[name="investmentStatus"]');const investmentWrap=form?.querySelector('.investment-value');const periodToggle=form?.querySelector('[data-period-toggle]');const periodFields=form?.querySelector('.period-fields');const modal=document.querySelector('[data-error-modal]');const modalErrors=modal?.querySelector('[data-modal-errors]');let lastCep='';
const upper=v=>String(v||'').toLocaleUpperCase('pt-BR');const digits=v=>String(v||'').replace(/\D/g,'');const option=(v,l)=>{const o=document.createElement('option');o.value=v;o.textContent=l;return o};const formatPhone=v=>{const d=digits(v).slice(0,11);if(d.length<=2)return d;if(d.length<=7)return `${d.slice(0,2)} ${d.slice(2)}`;return `${d.slice(0,2)} ${d.slice(2,7)}-${d.slice(7)}`};const formatCep=v=>{const d=digits(v).slice(0,8);return d.length<=5?d:`${d.slice(0,5)}-${d.slice(5)}`};const formatTax=v=>{const d=digits(v).slice(0,14);if(d.length<=11)return d.replace(/^(\d{3})(\d)/,'$1.$2').replace(/^(\d{3})\.(\d{3})(\d)/,'$1.$2.$3').replace(/\.(\d{3})(\d)/,'.$1-$2');return d.replace(/^(\d{2})(\d)/,'$1.$2').replace(/^(\d{2})\.(\d{3})(\d)/,'$1.$2.$3').replace(/\.(\d{3})(\d)/,'.$1/$2').replace(/(\/\d{4})(\d)/,'$1-$2')};
const validEmail=v=>/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i.test(String(v||'').trim());const validCpf=raw=>{const cpf=digits(raw);if(cpf.length!==11||/^(\d)\1{10}$/.test(cpf))return false;const calc=len=>{let sum=0;for(let i=0;i<len;i++)sum+=Number(cpf[i])*(len+1-i);const r=(sum*10)%11;return r===10?0:r};return calc(9)===Number(cpf[9])&&calc(10)===Number(cpf[10])};const validCnpj=raw=>{const c=digits(raw);if(c.length!==14||/^(\d)\1{13}$/.test(c))return false;const calc=base=>{const w=base===12?[5,4,3,2,9,8,7,6,5,4,3,2]:[6,5,4,3,2,9,8,7,6,5,4,3,2];let s=0;for(let i=0;i<base;i++)s+=Number(c[i])*w[i];const r=s%11;return r<2?0:11-r};return calc(12)===Number(c[12])&&calc(13)===Number(c[13])};
const openModal=errors=>{modalErrors.innerHTML='';errors.forEach(t=>{const li=document.createElement('li');li.textContent=t;modalErrors.append(li)});modal.hidden=false;document.documentElement.style.overflow='hidden'};const closeModal=()=>{modal.hidden=true;document.documentElement.style.overflow=''};modal?.querySelectorAll('[data-modal-close]').forEach(x=>x.addEventListener('click',closeModal));
form?.querySelectorAll('[data-upper]').forEach(el=>el.addEventListener('input',()=>el.value=upper(el.value)));nameInput?.addEventListener('beforeinput',e=>{if(e.data&&/\d/.test(e.data))e.preventDefault()});nameInput?.addEventListener('input',()=>nameInput.value=upper(nameInput.value.replace(/\d/g,'')));phoneInput?.addEventListener('input',()=>phoneInput.value=formatPhone(phoneInput.value));cepInput?.addEventListener('input',()=>cepInput.value=formatCep(cepInput.value));taxInput?.addEventListener('input',()=>taxInput.value=formatTax(taxInput.value));obs?.addEventListener('input',()=>{obsCount.textContent=String(obs.value.length)});
const loadStates=async()=>{try{const r=await fetch(`${apiBase}/api/public/locations/states`);const rows=await r.json();stateSelect.innerHTML='';stateSelect.append(option('',copy.choose));rows.forEach(x=>stateSelect.append(option(x.code,x.name)))}catch{stateSelect.innerHTML='';stateSelect.append(option('',copy.choose))}};const loadCities=async(uf,selected='')=>{citySelect.disabled=true;citySelect.innerHTML='';citySelect.append(option('',copy.loading));if(!uf)return;try{const r=await fetch(`${apiBase}/api/public/locations/cities/${encodeURIComponent(uf)}`);const rows=await r.json();citySelect.innerHTML='';citySelect.append(option('',copy.choose));rows.forEach(x=>citySelect.append(option(x.name,x.name)));if(selected){const m=[...citySelect.options].find(x=>upper(x.value)===upper(selected));if(m)citySelect.value=m.value}citySelect.disabled=false}catch{citySelect.innerHTML='';citySelect.append(option('',copy.choose))}};stateSelect?.addEventListener('change',()=>loadCities(stateSelect.value));loadStates();
const isLocal=()=>upper(form.elements.partnerType?.value||'').includes('LOCAL / CASA');const isSupplier=()=>upper(form.elements.partnerType?.value||'').includes('FORNECEDOR');const syncPartner=()=>{form.querySelectorAll('.local-only').forEach(el=>{el.hidden=!isLocal();const input=el.querySelector('input');if(input&&['postalCode','neighborhood','street','addressNumber'].includes(input.name))input.required=isLocal()});form.querySelectorAll('.supplier-only').forEach(el=>{el.hidden=!isSupplier();const input=el.querySelector('input');if(input)input.required=isSupplier()})};form?.querySelectorAll('input[name="partnerType"]').forEach(x=>x.addEventListener('change',syncPartner));
const lookupCep=async()=>{if(!isLocal())return;const cep=digits(cepInput?.value);if(cep.length!==8||cep===lastCep)return;lastCep=cep;cepStatus.textContent=copy.loading;try{const r=await fetch(`${apiBase}/api/public/locations/cep/${cep}`);const data=await r.json();if(!r.ok)throw new Error();if(data.state){stateSelect.value=data.state;await loadCities(data.state,data.city||'')}if(data.neighborhood)form.elements.neighborhood.value=upper(data.neighborhood);if(data.street)form.elements.street.value=upper(data.street);if(data.complement&&!form.elements.complement.value)form.elements.complement.value=upper(data.complement);cepStatus.textContent=copy.cepFound;form.elements.addressNumber?.focus()}catch{cepStatus.textContent=copy.cepNotFound}};cepInput?.addEventListener('blur',lookupCep);cepInput?.addEventListener('input',()=>{if(digits(cepInput.value).length===8)setTimeout(lookupCep,80)});
const syncOther=()=>{const selected=[...form.querySelectorAll('input[name="proposalTypes"]:checked')].map(x=>upper(x.value));const on=selected.includes('OUTRO');otherWrap.hidden=!on;otherInput.required=on;if(!on)otherInput.value=''};form?.querySelectorAll('input[name="proposalTypes"]').forEach(x=>x.addEventListener('change',syncOther));investment?.addEventListener('change',()=>{investmentWrap.hidden=investment.value!=='SIM';if(investment.value!=='SIM')form.elements.investmentValue.value=''});periodToggle?.addEventListener('change',()=>{periodFields.hidden=!periodToggle.checked;if(!periodToggle.checked){form.elements.startsAt.value='';form.elements.endsAt.value=''}});
form?.addEventListener('submit',async e=>{e.preventDefault();if(msg)msg.textContent='';const fd=new FormData(form);const errors=[];const contact=String(fd.get('contactName')||'').trim();const email=String(fd.get('email')||'').trim();const tax=digits(fd.get('taxId'));const proposals=fd.getAll('proposalTypes').map(String);if(!fd.get('partnerType'))errors.push(es?'SELECCIONA EL TIPO DE SOCIO.':'SELECIONE O TIPO DE PARCEIRO.');if(contact.length<5||/\d/.test(contact))errors.push(es?'INFORMA UN NOMBRE COMPLETO VÁLIDO, SIN NÚMEROS.':'INFORME UM NOME COMPLETO VÁLIDO, SEM NÚMEROS.');if(!fd.get('contactRole'))errors.push(es?'INFORMA EL CARGO O FUNCIÓN DEL RESPONSABLE.':'INFORME O CARGO OU FUNÇÃO DO RESPONSÁVEL.');if(digits(fd.get('whatsapp')).length!==11)errors.push(es?'INFORMA UN WHATSAPP CON DDD Y 9 DÍGITOS.':'INFORME UM WHATSAPP COM DDD E 9 DÍGITOS.');if(!validEmail(email))errors.push(es?'INFORMA UN E-MAIL VÁLIDO.':'INFORME UM E-MAIL VÁLIDO.');if(!fd.get('tradeName'))errors.push(es?'INFORMA EL NOMBRE DE LA ORGANIZACIÓN O PROYECTO.':'INFORME O NOME DA ORGANIZAÇÃO OU PROJETO.');if(!fd.get('segment'))errors.push(es?'INFORMA EL SEGMENTO O ÁREA.':'INFORME O SEGMENTO OU ÁREA.');if(tax&&!(tax.length===11?validCpf(tax):tax.length===14&&validCnpj(tax)))errors.push(es?'REVISA EL CPF / CNPJ INFORMADO.':'REVISE O CPF / CNPJ INFORMADO.');if(!stateSelect.value||!citySelect.value)errors.push(es?'SELECCIONA ESTADO Y CIUDAD.':'SELECIONE ESTADO E CIDADE.');if(isLocal()){if(digits(fd.get('postalCode')).length!==8)errors.push(es?'INFORMA UN CEP VÁLIDO PARA EL ESPACIO.':'INFORME UM CEP VÁLIDO PARA O LOCAL.');if(!fd.get('neighborhood')||!fd.get('street')||!fd.get('addressNumber'))errors.push(es?'COMPLETA BARRIO, DIRECCIÓN Y NÚMERO DEL ESPACIO.':'PREENCHA BAIRRO, RUA E NÚMERO DO LOCAL.')}if(isSupplier()&&(!fd.get('serviceType')||!fd.get('serviceArea')))errors.push(es?'COMPLETA TIPO DE SERVICIO Y ÁREA DE ACTUACIÓN.':'PREENCHA TIPO DE SERVIÇO E ÁREA DE ATUAÇÃO.');if(!proposals.length)errors.push(e