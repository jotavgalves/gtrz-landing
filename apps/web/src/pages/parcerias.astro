---
import SiteLayout from '@/layouts/SiteLayout.astro';import type {Locale} from '@/lib/cms';
const locale:Locale=Astro.url.searchParams.get('lang')==='es'?'es':'pt-BR';const es=locale==='es';const apiBase=import.meta.env.PUBLIC_API_BASE||'';
---
<SiteLayout locale={locale} title={es?'Alianzas — GTRZ':'Parcerias — GTRZ'}>
<main class="form-page"><section class="form-hero"><div class="shell"><span class="eyebrow">GTRZ · {es?'ALIANZAS':'PARCERIAS'}</span><h1>{es?'CONSTRUYAMOS ALGO JUNTOS.':'VAMOS CONSTRUIR JUNTOS.'}</h1><p>{es?'Espacios, marcas, artistas, proveedores y proyectos que quieran crear una experiencia con GTRZ.':'Casas, marcas, artistas, fornecedores e projetos que queiram construir uma experiência com a GTRZ.'}</p></div></section><section class="paper-section"><div class="shell form-shell"><form data-public-form="partnerships"><div class="form-grid-public"><label><span>{es?'Tu nombre':'Seu nome'}</span><input name="contactName" required maxlength="160"/></label><label><span>{es?'Empresa / proyecto':'Empresa / projeto'}</span><input name="companyName"/></label><label><span>{es?'Tipo de alianza':'Tipo de parceria'}</span><select name="partnershipType" required><option value="">—</option><option value="venue">{es?'Espacio / casa':'Casa / espaço'}</option><option value="brand">{es?'Marca / patrocinio':'Marca / patrocínio'}</option><option value="artist">{es?'Artista / proyecto cultural':'Artista / projeto cultural'}</option><option value="supplier">{es?'Proveedor':'Fornecedor'}</option><option value="other">{es?'Otro':'Outro'}</option></select></label><label><span>{es?'Ciudad':'Cidade'}</span><input name="city"/></label><label><span>E-mail</span><input name="email" type="email"/></label><label><span>WhatsApp</span><input name="whatsapp"/></label><label class="wide"><span>{es?'Cuéntanos la idea':'Conte a ideia'}</span><textarea name="message" required></textarea></label></div><div class="form-submit"><p data-form-message></p><button class="button primary" type="submit">{es?'Enviar propuesta':'Enviar proposta'}</button></div></form></div></section></main>
<script define:vars={{apiBase,es}}>
 const form=document.querySelector('[data-public-form="partnerships"]');const msg=form?.querySelector('[data-form-message]');form?.addEventListener('submit',async(e)=>{e.preventDefault();const payload=Object.fromEntries(new FormData(form).entries());try{const r=await fetch(`${apiBase}/api/public/partnerships`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error();if(msg)msg.textContent=es?'Propuesta recibida. Nuestro equipo la revisará.':'Proposta recebida. Nossa equipe vai analisar.';form.reset();}catch{if(msg)msg.textContent=es?'No fue posible enviar. Inténtalo nuevamente.':'Não foi possível enviar. Tente novamente.';}});
</script>
</SiteLayout>
