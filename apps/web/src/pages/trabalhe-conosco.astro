---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Turnstile from '@/components/Turnstile.astro';
import { getHomePage } from '@/lib/cms';
import { getPublicCopy } from '@/lib/public-copy';
import type { Locale } from '@/lib/cms';
const locale: Locale = Astro.url.searchParams.get('lang') === 'es' ? 'es' : 'pt-BR';
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const site=await getHomePage();
const c=getPublicCopy(site.settings,locale,'freelancerPage');
---
<SiteLayout locale={locale} title={c.seoTitle} settings={site.settings}>
  <main class="form-page">
    <section class="form-hero" data-section="freelancer_intro">
      <div class="shell">
        <span class="eyebrow">{c.eyebrow}</span>
        <h1>{c.title}</h1>
        <p>{c.intro}</p>
      </div>
    </section>
    <section class="paper-section" data-section="freelancer_form">
      <div class="shell form-shell">
        <form data-public-form="freelancers">
          <div class="form-grid-public">
            <label><span>{c.nameLabel}</span><input name="name" required maxlength="160" /></label>
            <label><span>{c.whatsappLabel}</span><input name="whatsapp" required maxlength="50" /></label>
            <label><span>{c.emailLabel}</span><input name="email" type="email" /></label>
            <label><span>{c.cityLabel}</span><input name="city" required /></label>
            <label><span>{c.stateLabel}</span><input name="state" maxlength="40" /></label>
            <label><span>{c.instagramLabel}</span><input name="instagram" /></label>
            <label class="wide"><span>{c.rolesLabel}</span><input name="roles" placeholder={c.rolesPlaceholder} /></label>
            <label class="wide"><span>{c.portfolioLabel}</span><input name="portfolioUrl" type="url" placeholder={c.portfolioPlaceholder} /></label>
            <label class="wide"><span>{c.availabilityLabel}</span><textarea name="availability"></textarea></label>
          </div>
          <Turnstile action="freelancer" />
          <div class="form-submit"><p data-form-message></p><button class="button primary" type="submit">{c.submitLabel}</button></div>
        </form>
      </div>
    </section>
  </main>
  <script define:vars={{ apiBase, successMessage:c.successMessage, errorMessage:c.errorMessage }}>
    const form = document.querySelector('[data-public-form="freelancers"]');
    const msg = form?.querySelector('[data-form-message]');
    let started = false;
    form?.addEventListener('focusin', () => {
      if (!started) { started = true; window.gtrzTrack?.('freelancer_form_start', { section:'freelancer_form' }); }
    });
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());
      payload.roles = String(payload.roles || '').split(',').map(x => x.trim()).filter(Boolean);
      payload.turnstileToken = payload['cf-turnstile-response'] || undefined;
      delete payload['cf-turnstile-response'];
      try {
        const r = await fetch(`${apiBase}/api/public/freelancers`, { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify(payload) });
        if (!r.ok) throw new Error();
        window.gtrzTrack?.('freelancer_form_submit', { section:'freelancer_form' });
        if (msg) msg.textContent = successMessage;
        form.reset();
      } catch {
        if (msg) msg.textContent = errorMessage;
      }
    });
  </script>
</SiteLayout>
