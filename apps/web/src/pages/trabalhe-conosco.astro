---
import SiteLayout from '@/layouts/SiteLayout.astro';import type {Locale} from '@/lib/cms';
const locale:Locale=Astro.url.searchParams.get('lang')==='es'?'es':'pt-BR';const es=locale==='es';const apiBase=import.meta.env.PUBLIC_API_BASE||'';
---
<SiteLayout locale={locale} title={es?'Freelancers — GTRZ':'Trabalhe conosco — GTRZ'}>
<main class="form-page"><section class="form-hero"><div class="shell"><span class="eyebrow">GTRZ · FREELANCERS</span><h1>{es?'TRABAJA CON NOSOTROS.':'TRABALHE COM A GENTE.'}</h1><p>{es?'Regístrate en nuestra base de profesionales para futuras producciones. El registro no representa una promesa de contratación.':'Cadastre-se no nosso banco de profissionais para futuras produções. O cadastro não representa promessa de contratação.'}</p></div></section><section class="paper-section"><div class="shell form-shell"><form data-public-form="freelancers"><div class="form-grid-public"><label><span>{es?'Nombre completo':'Nome completo'}</span><input name="name" required maxlength="160"/></label><label><span>WhatsApp</span><input name="whatsapp" required maxlength="50"/></label><label><span>E-mail</span><input name="email" type="email"/></label><label><span>{es?'Ciudad':'Cidade'}</span><input name="city" required/></label><label><span>{es?'Estado':'Estado'}</span><input name="state" maxlength="40"/></label><label><span>Instagram</span><input name="instagram"/></label><label class="wide"><span>{es?'Áreas de trabajo':'Áreas de atuação'}</span><input name="roles" placeholder={es?'Producción, foto, bar, diseño...':'Produção, foto, bar, design...'}/></label><label class="wide"><span>Portfólio</span><input name="portfolioUrl" type="url" placeholder="https://"/></label><label class="wide"><span>{es?'Disponibilidad / observaciones':'Disponibilidade / observações'}</span><textarea name="availability"></textarea></label></div><div class="form-submit"><p data-form-message></p><button class="button primary" type="submit">{es?'Enviar registro':'Enviar cadastro'}</button></div></form></div></section></main>
<script define:vars={{apiBase,es}}>
 const form=document.querySelector('[data-public-form="freelancers"]');const msg=form?.querySelector('[data-form-message]');form?.addEventListener('submit',async(e)=>{e.preventDefault();const fd=new FormData(form);const payload=Object.fromEntries(fd.entries());payload.roles=String(payload.roles||'').split(',').map(x=>x.trim()).filter(Boolean);try{const r=await fetch(`${apiBase}/api/public/freelancers`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error();if(msg)msg.textContent=es?'Registro recibido. GTRZ se pondrá en contacto cuando exista una oportunidad compatible.':'Cadastro recebido. A GTRZ entrará em contato quando houver uma oportunidade compatível.';form.reset();}catch{if(msg)msg.textContent=es?'No fue posible enviar. Inténtalo nuevamente.':'Não foi possível enviar. Tente novamente.';}});
</script>
</SiteLayout>
