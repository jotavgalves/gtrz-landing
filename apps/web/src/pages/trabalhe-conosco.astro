---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Turnstile from '@/components/Turnstile.astro';
import { getHomePage } from '@/lib/cms';
import type { Locale } from '@/lib/cms';
const locale: Locale = Astro.url.searchParams.get('lang') === 'es' ? 'es' : 'pt-BR';
const es=locale==='es';
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const site=await getHomePage();
const recruitment=(site.settings as any)?.recruitment||{};
const defaultRoles=['DJ','FOTÓGRAFO(A)','VIDEOMAKER','SEGURANÇA','BOMBEIRO(A)','RECEPÇÃO','BARMAN','GARÇOM','LIMPEZA','OUTROS'];
const roles=Array.isArray(recruitment.roles)&&recruitment.roles.length?recruitment.roles:defaultRoles;
const copy=es?{
  eyebrow:'TRABAJA CON NOSOTROS',title:'ENTRA EN LA RED GTRZ.',intro:'Registra tu perfil para futuras producciones. Puedes seleccionar todas las funciones en las que quieras participar.',identity:'DATOS PERSONALES',location:'DÓNDE ESTÁS',roles:'FUNCIONES',materials:'CURRÍCULO Y PORTAFOLIO',name:'NOMBRE COMPLETO',cpf:'CPF',birth:'FECHA DE NACIMIENTO',whatsapp:'WHATSAPP',email:'E-MAIL',state:'ESTADO',city:'CIUDAD',neighborhood:'BARRIO',other:'DESCRIBE LA OTRA FUNCIÓN',resume:'CURRÍCULO EN PDF · OPCIONAL',portfolio:'PORTAFOLIO · OPCIONAL',availability:'DISPONIBILIDAD / OBSERVACIONES · OPCIONAL',submit:'ENVIAR CANDIDATURA Y CONTINUAR EN WHATSAPP',loading:'CARGANDO…',choose:'SELECCIONA',success:'CANDIDATURA GUARDADA. ABRIENDO WHATSAPP…',errorTitle:'REVISA TU CANDIDATURA',errorIntro:'CORRIGE LOS SIGUIENTES CAMPOS ANTES DE CONTINUAR:',close:'ENTENDIDO',ageTitle:'REQUISITO DE EDAD',ageMessage:'ES NECESARIO TENER AL MENOS 18 AÑOS. SE SOLICITARÁ UN DOCUMENTO PARA COMPROBAR LA EDAD; CAMBIAR LA FECHA INFORMADA NO SUSTITUYE ESA COMPROBACIÓN.'
}:{
  eyebrow:'TRABALHE CONOSCO',title:'ENTRE PARA A REDE GTRZ.',intro:'Cadastre seu perfil para futuras produções. Você pode selecionar todas as funções em que está disposto a trabalhar.',identity:'DADOS PESSOAIS',location:'ONDE VOCÊ ESTÁ',roles:'FUNÇÕES',materials:'CURRÍCULO E PORTFÓLIO',name:'NOME COMPLETO',cpf:'CPF',birth:'DATA DE NASCIMENTO',whatsapp:'WHATSAPP',email:'E-MAIL',state:'ESTADO',city:'CIDADE',neighborhood:'BAIRRO',other:'DESCREVA A OUTRA FUNÇÃO',resume:'CURRÍCULO EM PDF · OPCIONAL',portfolio:'PORTFÓLIO · OPCIONAL',availability:'DISPONIBILIDADE / OBSERVAÇÕES · OPCIONAL',submit:'ENVIAR CANDIDATURA E CONTINUAR NO WHATSAPP',loading:'CARREGANDO…',choose:'SELECIONE',success:'CANDIDATURA SALVA. ABRINDO O WHATSAPP…',errorTitle:'REVISE SUA CANDIDATURA',errorIntro:'CORRIJA OS ITENS ABAIXO ANTES DE CONTINUAR:',close:'ENTENDI',ageTitle:'REQUISITO DE IDADE',ageMessage:'É NECESSÁRIO TER PELO MENOS 18 ANOS. SERÁ SOLICITADO DOCUMENTO PARA COMPROVAÇÃO DA IDADE; ALTERAR A DATA INFORMADA NÃO SUBSTITUI ESSA COMPROVAÇÃO.'
};
---
<SiteLayout locale={locale} title={es?'Trabaja con nosotros · GTRZ':'Trabalhe conosco · GTRZ'} settings={site.settings}>
  <main class="recruitment-page">
    <section class="recruitment-hero" data-section="freelancer_intro">
      <div class="shell recruitment-hero-grid">
        <div><span class="eyebrow">{copy.eyebrow}</span><h1 class="display">{copy.title}</h1></div>
        <p>{copy.intro}</p>
      </div>
    </section>

    <section class="recruitment-section" data-section="freelancer_form">
      <div class="shell recruitment-shell">
        <form data-public-form="freelancers" novalidate>
          <fieldset class="recruitment-block">
            <legend><span>01</span>{copy.identity}</legend>
            <div class="recruitment-grid">
              <label><span>{copy.name} *</span><input name="name" required maxlength="160" autocomplete="name" data-upper /></label>
              <label><span>{copy.cpf} *</span><input name="cpf" required inputmode="numeric" autocomplete="off" data-cpf placeholder="000.000.000-00" /></label>
              <label><span>{copy.birth} *</span><input name="birthDate" required inputmode="numeric" autocomplete="bday" data-birth placeholder="DD/MM/AAAA" maxlength="10" /></label>
              <label><span>{copy.whatsapp} *</span><input name="whatsapp" required inputmode="tel" autocomplete="tel" data-phone placeholder="81 90000-0000" maxlength="13" /></label>
              <label class="wide"><span>{copy.email} *</span><input name="email" type="email" required maxlength="200" autocomplete="email" placeholder="NOME@EMAIL.COM" /></label>
            </div>
          </fieldset>

          <fieldset class="recruitment-block">
            <legend><span>02</span>{copy.location}</legend>
            <div class="recruitment-grid three">
              <label><span>{copy.state} *</span><select name="state" required data-state><option value="">{copy.loading}</option></select></label>
              <label><span>{copy.city} *</span><select name="city" required data-city disabled><option value="">{copy.choose}</option></select></label>
              <label><span>{copy.neighborhood} *</span><input name="neighborhood" required maxlength="120" data-upper autocomplete="address-level3" /></label>
            </div>
          </fieldset>

          <fieldset class="recruitment-block">
            <legend><span>03</span>{copy.roles}</legend>
            <p class="block-help">{es?'SELECCIONA UNA O MÁS OPCIONES.':'MARQUE UMA OU MAIS OPÇÕES.'}</p>
            <div class="role-picker" data-role-picker>
              {roles.map((role:string)=><label class="role-choice"><input type="checkbox" name="roles" value={String(role).toLocaleUpperCase('pt-BR')} /><span>{String(role).toLocaleUpperCase('pt-BR')}</span></label>)}
            </div>
            <label class="other-role" hidden data-other-role><span>{copy.other} *</span><input name="otherRole" maxlength="160" data-upper /></label>
          </fieldset>

          <fieldset class="recruitment-block">
            <legend><span>04</span>{copy.materials}</legend>
            <div class="recruitment-grid">
              <label class="file-field"><span>{copy.resume}</span><input name="resume" type="file" accept="application/pdf,.pdf" /><small>PDF · MÁX. 5 MB</small></label>
              <label><span>{copy.portfolio}</span><input name="portfolioUrl" type="url" maxlength="1000" placeholder="HTTPS://" /></label>
              <label class="wide"><span>{copy.availability}</span><textarea name="availability" maxlength="3000" data-upper rows="5"></textarea></label>
            </div>
          </fieldset>

          <Turnstile action="freelancer" />
          <div class="recruitment-submit"><p data-form-message aria-live="polite"></p><button class="button primary" type="submit">{copy.submit}</button></div>
        </form>
      </div>
    </section>
  </main>

  <div class="form-modal" hidden data-error-modal role="dialog" aria-modal="true" aria-labelledby="recruitment-modal-title">
    <button class="form-modal-backdrop" type="button" aria-label={copy.close} data-modal-close></button>
    <div class="form-modal-card">
      <div class="form-modal-mark">!</div>
      <h2 id="recruitment-modal-title" data-modal-title>{copy.errorTitle}</h2>
      <p data-modal-intro>{copy.errorIntro}</p>
      <ul data-modal-errors></ul>
      <button class="button primary" type="button" data-modal-close>{copy.close}</button>
    </div>
  </div>

  <script define:vars={{ apiBase, copy, es }}>
    const form=document.querySelector('[data-public-form="freelancers"]');
    const msg=form?.querySelector('[data-form-message]');
    const stateSelect=form?.querySelector('[data-state]');
    const citySelect=form?.querySelector('[data-city]');
    const otherWrap=form?.querySelector('[data-other-role]');
    const otherInput=form?.querySelector('[name="otherRole"]');
    const cpfInput=form?.querySelector('[data-cpf]');
    const phoneInput=form?.querySelector('[data-phone]');
    const birthInput=form?.querySelector('[data-birth]');
    const modal=document.querySelector('[data-error-modal]');
    const modalTitle=modal?.querySelector('[data-modal-title]');
    const modalIntro=modal?.querySelector('[data-modal-intro]');
    const modalErrors=modal?.querySelector('[data-modal-errors]');
    let started=false;

    const upper=v=>String(v||'').toLocaleUpperCase('pt-BR');
    const digits=v=>String(v||'').replace(/\D/g,'');
    const option=(value,label)=>{const o=document.createElement('option');o.value=value;o.textContent=label;return o};
    const setMessage=text=>{if(msg)msg.textContent=text||''};
    const validCpf=raw=>{const cpf=digits(raw);if(cpf.length!==11||/^(\d)\1{10}$/.test(cpf))return false;const calc=len=>{let sum=0;for(let i=0;i<len;i++)sum+=Number(cpf[i])*(len+1-i);const r=(sum*10)%11;return r===10?0:r};return calc(9)===Number(cpf[9])&&calc(10)===Number(cpf[10])};
    const validEmail=value=>/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i.test(String(value||'').trim());
    const formatCpf=value=>{const d=digits(value).slice(0,11);return d.replace(/^(\d{3})(\d)/,'$1.$2').replace(/^(\d{3})\.(\d{3})(\d)/,'$1.$2.$3').replace(/\.(\d{3})(\d)/,'.$1-$2')};
    const formatPhone=value=>{const d=digits(value).slice(0,11);if(d.length<=2)return d;if(d.length<=7)return `${d.slice(0,2)} ${d.slice(2)}`;return `${d.slice(0,2)} ${d.slice(2,7)}-${d.slice(7)}`};
    const formatDate=value=>{const d=digits(value).slice(0,8);if(d.length<=2)return d;if(d.length<=4)return `${d.slice(0,2)}/${d.slice(2)}`;return `${d.slice(0,2)}/${d.slice(2,4)}/${d.slice(4)}`};
    const dateToIso=value=>{const m=String(value||'').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);if(!m)return '';const iso=`${m[3]}-${m[2]}-${m[1]}`;const dt=new Date(`${iso}T12:00:00Z`);if(Number.isNaN(dt.getTime())||dt.getUTCFullYear()!==Number(m[3])||dt.getUTCMonth()+1!==Number(m[2])||dt.getUTCDate()!==Number(m[1]))return '';return iso};
    const ageFromIso=iso=>{if(!iso)return -1;const birth=new Date(`${iso}T12:00:00Z`);const now=new Date();let age=now.getUTCFullYear()-birth.getUTCFullYear();const m=now.getUTCMonth()-birth.getUTCMonth();if(m<0||(m===0&&now.getUTCDate()<birth.getUTCDate()))age--;return age};

    const openModal=(errors,{age=false}={})=>{
      if(!modal)return;
      modalTitle.textContent=age?copy.ageTitle:copy.errorTitle;
      modalIntro.textContent=age?copy.ageMessage:copy.errorIntro;
      modalErrors.innerHTML='';
      if(!age)errors.forEach(text=>{const li=document.createElement('li');li.textContent=text;modalErrors.append(li)});
      modal.hidden=false;document.documentElement.style.overflow='hidden';
    };
    const closeModal=()=>{if(!modal)return;modal.hidden=true;document.documentElement.style.overflow=''};
    modal?.querySelectorAll('[data-modal-close]').forEach(button=>button.addEventListener('click',closeModal));
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!modal?.hidden)closeModal()});

    form?.querySelectorAll('[data-upper]').forEach(el=>el.addEventListener('input',()=>{const s=el.selectionStart;el.value=upper(el.value);try{el.setSelectionRange(s,s)}catch{}}));
    cpfInput?.addEventListener('input',()=>{cpfInput.value=formatCpf(cpfInput.value)});
    phoneInput?.addEventListener('input',()=>{phoneInput.value=formatPhone(phoneInput.value)});
    birthInput?.addEventListener('input',()=>{birthInput.value=formatDate(birthInput.value)});
    form?.addEventListener('focusin',()=>{if(!started){started=true;window.gtrzTrack?.('freelancer_form_start',{section:'freelancer_form'})}});

    const loadStates=async()=>{try{const r=await fetch(`${apiBase}/api/public/locations/states`);const rows=await r.json();stateSelect.innerHTML='';stateSelect.append(option('',copy.choose));rows.forEach(x=>stateSelect.append(option(x.code,x.name)))}catch{stateSelect.innerHTML='';stateSelect.append(option('',copy.choose))}};
    stateSelect?.addEventListener('change',async()=>{citySelect.disabled=true;citySelect.innerHTML='';citySelect.append(option('',copy.loading));const uf=stateSelect.value;if(!uf){citySelect.innerHTML='';citySelect.append(option('',copy.choose));return}try{const r=await fetch(`${apiBase}/api/public/locations/cities/${encodeURIComponent(uf)}`);const rows=await r.json();citySelect.innerHTML='';citySelect.append(option('',copy.choose));rows.forEach(x=>citySelect.append(option(x.name,x.name)));citySelect.disabled=false}catch{citySelect.innerHTML='';citySelect.append(option('',copy.choose))}});
    form?.querySelectorAll('input[name="roles"]').forEach(input=>input.addEventListener('change',()=>{const selected=[...form.querySelectorAll('input[name="roles"]:checked')].map(x=>upper(x.value));const custom=selected.includes('OUTROS');otherWrap.hidden=!custom;otherInput.required=custom;if(!custom)otherInput.value=''}));
    loadStates();

    const signalUnderage=async(cpf,birthDate)=>{
      if(!validCpf(cpf)||!birthDate)return;
      try{const fd=new FormData();fd.set('cpf',digits(cpf));fd.set('birthDate',birthDate);await fetch(`${apiBase}/api/public/freelancers`,{method:'POST',body:fd})}catch{}
    };

    form?.addEventListener('submit',async e=>{
      e.preventDefault();setMessage('');
      const name=form.elements.name.value.trim();
      const cpf=form.elements.cpf.value;
      const whatsapp=form.elements.whatsapp.value;
      const email=form.elements.email.value.trim();
      const birthDisplay=form.elements.birthDate.value;
      const birthDate=dateToIso(birthDisplay);
      const age=ageFromIso(birthDate);
      const neighborhood=form.elements.neighborhood.value.trim();
      const selectedRoles=[...form.querySelectorAll('input[name="roles"]:checked')];

      if(age>=0&&age<18){
        signalUnderage(cpf,birthDate);
        openModal([],{age:true});
        return;
      }

      const errors=[];
      if(/\d/.test(name)||name.length<5)errors.push(es?'EL NOMBRE COMPLETO NO PUEDE CONTENER NÚMEROS.':'NOME COMPLETO NÃO PODE CONTER NÚMEROS.');
      if(!validCpf(cpf))errors.push(es?'INFORMA UN CPF VÁLIDO.':'INFORME UM CPF VÁLIDO.');
      if(!birthDate)errors.push(es?'INFORMA UNA FECHA DE NACIMIENTO VÁLIDA EN DD/MM/AAAA.':'INFORME UMA DATA DE NASCIMENTO VÁLIDA NO FORMATO DD/MM/AAAA.');
      else if(age>109||age<0)errors.push(es?'REVISA LA FECHA DE NACIMIENTO.':'REVISE A DATA DE NASCIMENTO.');
      if(digits(whatsapp).length!==11)errors.push(es?'WHATSAPP DEBE TENER DDD Y 9 DÍGITOS.':'WHATSAPP DEVE TER DDD E 9 DÍGITOS, EX.: 81 90000-0000.');
      if(!validEmail(email))errors.push(es?'INFORMA UN E-MAIL VÁLIDO.':'INFORME UM E-MAIL VÁLIDO.');
      if(!stateSelect.value)errors.push(es?'SELECCIONA EL ESTADO.':'SELECIONE O ESTADO.');
      if(!citySelect.value)errors.push(es?'SELECCIONA LA CIUDAD.':'SELECIONE A CIDADE.');
      if(!neighborhood)errors.push(es?'INFORMA EL BARRIO.':'INFORME O BAIRRO.');
      if(!selectedRoles.length)errors.push(es?'SELECCIONA AL MENOS UNA FUNCIÓN.':'SELECIONE PELO MENOS UMA FUNÇÃO.');
      if(otherInput.required&&!otherInput.value.trim())errors.push(es?'DESCRIBE LA FUNCIÓN “OTROS”.':'DESCREVA A FUNÇÃO “OUTROS”.');
      const resume=form.elements.resume.files?.[0];
      if(resume&&resume.type!=='application/pdf')errors.push(es?'EL CURRÍCULO DEBE SER PDF.':'O CURRÍCULO DEVE SER UM ARQUIVO PDF.');
      if(resume&&resume.size>5*1024*1024)errors.push(es?'EL CURRÍCULO DEBE TENER HASTA 5 MB.':'O CURRÍCULO DEVE TER NO MÁXIMO 5 MB.');
      if(form.elements.portfolioUrl.value&&!form.elements.portfolioUrl.validity.valid)errors.push(es?'REVISA LA URL DEL PORTAFOLIO.':'REVISE O LINK DO PORTFÓLIO.');
      if(errors.length){openModal(errors);return}

      const fd=new FormData(form);
      fd.set('name',upper(name));
      fd.set('cpf',digits(cpf));
      fd.set('birthDate',birthDate);
      fd.set('whatsapp',digits(whatsapp));
      fd.set('email',email.toLowerCase());
      fd.set('state',upper(stateSelect.value));
      fd.set('city',upper(citySelect.value));
      fd.set('neighborhood',upper(neighborhood));
      const token=fd.get('cf-turnstile-response');fd.set('turnstileToken',String(token||''));fd.delete('cf-turnstile-response');
      const button=form.querySelector('button[type="submit"]');button.disabled=true;
      try{
        const r=await fetch(`${apiBase}/api/public/freelancers`,{method:'POST',body:fd});const result=await r.json().catch(()=>({}));
        if(!r.ok){
          if(result.error==='age_restricted'){openModal([],{age:true});return}
          const map={
            cpf_already_registered:es?'ESTE CPF YA TIENE UNA CANDIDATURA REGISTRADA.':'ESTE CPF JÁ POSSUI UMA CANDIDATURA REGISTRADA.',
            resume_pdf_only:es?'EL CURRÍCULO DEBE SER PDF.':'O CURRÍCULO DEVE SER PDF.',
            resume_too_large:es?'EL PDF DEBE TENER HASTA 5 MB.':'O PDF DEVE TER ATÉ 5 MB.',
            challenge_failed:es?'NO FUE POSIBLE VALIDAR EL ENVÍO. RECARGA LA PÁGINA E INTÉNTALO NUEVAMENTE.':'NÃO FOI POSSÍVEL VALIDAR O ENVIO. RECARREGUE A PÁGINA E TENTE NOVAMENTE.',
            rate_limited:es?'HUBO MUCHOS INTENTOS EN POCO TIEMPO. INTÉNTALO MÁS TARDE.':'HOUVE MUITAS TENTATIVAS EM POUCO TEMPO. TENTE NOVAMENTE MAIS TARDE.'
          };
          openModal([map[result.error]||(es?'NO FUE POSIBLE ENVIAR LA CANDIDATURA.':'NÃO FOI POSSÍVEL ENVIAR A CANDIDATURA.')]);
          return;
        }
        window.gtrzTrack?.('freelancer_form_submit',{section:'freelancer_form'});setMessage(copy.success);
        const selectedRoleText=[...selectedRoles].map(x=>upper(x.value)).join(', ');
        const text=[
          'CANDIDATURA GTRZ','',`PROTOCOLO: ${result.id}`,`NOME: ${upper(name)}`,`CPF: ${digits(cpf)}`,`DATA DE NASCIMENTO: ${birthDisplay}`,`WHATSAPP: ${formatPhone(whatsapp)}`,`E-MAIL: ${email.toLowerCase()}`,`ESTADO: ${upper(stateSelect.value)}`,`CIDADE: ${upper(citySelect.value)}`,`BAIRRO: ${upper(neighborhood)}`,`FUNÇÕES: ${selectedRoleText}`,
          otherInput.value?`OUTRA FUNÇÃO: ${upper(otherInput.value)}`:'',form.elements.portfolioUrl.value?`PORTFÓLIO: ${form.elements.portfolioUrl.value}`:'',form.elements.availability.value?`OBSERVAÇÕES: ${upper(form.elements.availability.value)}`:'',resume?`CURRÍCULO: ${resume.name}`:'CURRÍCULO: NÃO ANEXADO'
        ].filter(Boolean).join('\n');
        if(result.whatsapp){window.location.href=`https://wa.me/${digits(result.whatsapp)}?text=${encodeURIComponent(text)}`}
      }catch{openModal([es?'NO FUE POSIBLE CONECTAR CON EL SERVIDOR.':'NÃO FOI POSSÍVEL CONECTAR AO SERVIDOR.'])}
      finally{button.disabled=false}
    });
  </script>

  <style>
    .recruitment-grid input,.recruitment-grid select,.recruitment-grid textarea{box-sizing:border-box;max-width:100%;min-width:0;width:100%}
    .other-role[hidden],.form-modal[hidden]{display:none!important}
    .other-role{display:block;margin-top:22px}
    .form-modal{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;padding:20px}
    .form-modal-backdrop{position:absolute;inset:0;border:0;background:rgba(0,0,0,.82);backdrop-filter:blur(8px)}
    .form-modal-card{position:relative;width:min(520px,100%);max-height:min(720px,calc(100dvh - 40px));overflow:auto;background:#0c0c0c;border:1px solid #343434;border-radius:28px;padding:30px;color:#fff;box-shadow:0 28px 90px rgba(0,0,0,.65)}
    .form-modal-mark{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:#ff2525;color:#fff;font-weight:900;font-size:26px;margin-bottom:20px}
    .form-modal-card h2{margin:0 0 10px;font-size:clamp(24px,6vw,34px);line-height:1;letter-spacing:.04em}
    .form-modal-card p{margin:0 0 18px;color:#b9b9b9;line-height:1.55;font-weight:700}
    .form-modal-card ul{margin:0 0 24px;padding:0;list-style:none;display:grid;gap:10px}
    .form-modal-card li{padding:13px 14px;border:1px solid #343434;border-radius:14px;background:#141414;font-size:13px;line-height:1.4;font-weight:800;letter-spacing:.02em}
    .form-modal-card .button{width:100%;justify-content:center}
    @media(max-width:640px){.form-modal{padding:14px}.form-modal-card{border-radius:22px;padding:24px 20px}.recruitment-grid.three{grid-template-columns:1fr!important}}
  </style>
</SiteLayout>
