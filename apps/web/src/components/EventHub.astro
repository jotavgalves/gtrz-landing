---
import type { CmsEvent,Locale,SiteSettings } from '@/lib/cms';
import { API_BASE } from '@/lib/api';

const {events,locale,siteSettings={}}=Astro.props as {events:CmsEvent[];locale:Locale;siteSettings?:SiteSettings};
const es=locale==='es';
const instagram=typeof siteSettings.social?.instagram==='string'&&siteSettings.social.instagram
  ?String(siteSettings.social.instagram)
  :'https://instagram.com/gtrzeventos';
const activeEvents=events.filter(event=>['published','sales_open','sold_out'].includes(event.status)).slice(0,6);

const copy=es?{
  navEvents:'Eventos',
  navInstagram:'Instagram',
  eyebrow:'AGENDA OFICIAL GTRZ',
  titleTop:'PRÓXIMAS',
  titleBottom:'NOCHES',
  intro:'Cada evento tiene una identidad propia. Elige dónde nos encontramos.',
  listLabel:'PRÓXIMOS EVENTOS',
  view:'VER EVENTO',
  coming:'PRÓXIMAMENTE',
  sales:'ENTRADAS DISPONIBLES',
  sold:'AGOTADO',
  emptyTitle:'NUEVAS FECHAS EN CAMINO',
  emptyBody:'Sigue a GTRZ para recibir primero los próximos anuncios.',
  emptyCta:'SEGUIR EN INSTAGRAM',
  footer:'GTRZ EVENTOS · CULTURA LATINA EN MOVIMIENTO'
}:{
  navEvents:'Eventos',
  navInstagram:'Instagram',
  eyebrow:'AGENDA OFICIAL GTRZ',
  titleTop:'PRÓXIMAS',
  titleBottom:'NOITES',
  intro:'Cada evento tem uma identidade própria. Escolha onde a GTRZ te encontra.',
  listLabel:'PRÓXIMOS EVENTOS',
  view:'VER EVENTO',
  coming:'EM BREVE',
  sales:'INGRESSOS DISPONÍVEIS',
  sold:'ESGOTADO',
  emptyTitle:'NOVAS DATAS A CAMINHO',
  emptyBody:'Acompanhe a GTRZ para receber primeiro os próximos anúncios.',
  emptyCta:'SEGUIR NO INSTAGRAM',
  footer:'GTRZ EVENTOS · CULTURA LATINA EM MOVIMENTO'
};

const parseTheme=(event:CmsEvent)=>{try{return JSON.parse(event.theme_json||'{}')}catch{return {}}};
const posterId=(event:CmsEvent)=>{
  const theme=parseTheme(event);
  return theme.posterMediaId||theme.poster_media_id||event.hero_media_id||null;
};
const mediaUrl=(id?:string|null)=>id?`${API_BASE}/api/media/${encodeURIComponent(id)}`:'';
const formatDate=(iso:string)=>{
  try{
    return new Intl.DateTimeFormat(es?'es-ES':'pt-BR',{day:'2-digit',month:'short'}).format(new Date(iso)).replace('.','').toUpperCase();
  }catch{return ''}
};
const formatTime=(iso:string)=>{
  try{return new Intl.DateTimeFormat(es?'es-ES':'pt-BR',{hour:'2-digit',minute:'2-digit'}).format(new Date(iso))}
  catch{return ''}
};
const status=(event:CmsEvent)=>event.status==='sales_open'?copy.sales:event.status==='sold_out'?copy.sold:copy.coming;
const location=(event:CmsEvent)=>[event.city,event.state].filter(Boolean).join(' · ');
---
<div class="event-hub" id="top">
  <header class="hub-header">
    <a class="hub-brand" href="#top" aria-label="GTRZ Eventos" data-track="hub.logo">
      <img src="/brand/gtrz-wordmark.svg" alt="GTRZ" />
    </a>

    <nav class="hub-nav" aria-label={es?'Navegación':'Navegação'}>
      <a class="hub-nav-events" href="#eventos" data-track="hub.nav.events">{copy.navEvents}</a>
      <a class="hub-nav-instagram" href={instagram} target="_blank" rel="noreferrer" data-track="hub.nav.instagram">{copy.navInstagram}</a>
      <div class="hub-lang" aria-label="Idioma">
        <a class:list={{active:!es}} href="?lang=pt-BR" data-track="hub.lang.pt">PT</a>
        <span>/</span>
        <a class:list={{active:es}} href="?lang=es" data-track="hub.lang.es">ES</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hub-hero">
      <div class="hub-shell hub-hero-grid">
        <div class="hub-hero-copy">
          <div class="hub-eyebrow"><span></span>{copy.eyebrow}</div>
          <h1><span>{copy.titleTop}</span><strong>{copy.titleBottom}</strong></h1>
        </div>

        <div class="hub-intro">
          <p>{copy.intro}</p>
          <a href="#eventos" class="hub-scroll" data-track="hub.hero.events">
            <span>{copy.navEvents}</span>
            <i aria-hidden="true">↓</i>
          </a>
        </div>
      </div>

      <div class="hub-marquee" aria-hidden="true">
        <div class="hub-marquee-track">
          <div class="hub-marquee-group">
            <span>GTRZ · JOÃO PESSOA · RECIFE · LATIN MUSIC · EXPERIÊNCIAS ·</span>
            <span>GTRZ · JOÃO PESSOA · RECIFE · LATIN MUSIC · EXPERIÊNCIAS ·</span>
            <span>GTRZ · JOÃO PESSOA · RECIFE · LATIN MUSIC · EXPERIÊNCIAS ·</span>
          </div>
          <div class="hub-marquee-group">
            <span>GTRZ · JOÃO PESSOA · RECIFE · LATIN MUSIC · EXPERIÊNCIAS ·</span>
            <span>GTRZ · JOÃO PESSOA · RECIFE · LATIN MUSIC · EXPERIÊNCIAS ·</span>
            <span>GTRZ · JOÃO PESSOA · RECIFE · LATIN MUSIC · EXPERIÊNCIAS ·</span>
          </div>
        </div>
      </div>
    </section>

    <section class="hub-events hub-shell" id="eventos" data-section="events">
      <div class="hub-section-head">
        <div class="hub-section-number">01</div>
        <div class="hub-section-label">
          <span>{copy.listLabel}</span>
          <i></i>
        </div>
      </div>

      {activeEvents.length ? (
        <div class:list={['hub-event-grid',activeEvents.length===1&&'single']}>
          {activeEvents.map((event,index)=>{
            const artwork=mediaUrl(posterId(event));
            const eventLocation=location(event);
            return (
              <article class:list={['hub-event-card',index===0&&'lead',!artwork&&'no-art']}>
                <a href={`/eventos/${event.slug}?lang=${locale}`} data-track={`hub.event.${event.slug}`} aria-label={`${copy.view}: ${event.title||event.slug}`}>
                  {artwork&&(
                    <div class="hub-event-media">
                      <img src={artwork} alt={event.title||event.slug} loading={index===0?'eager':'lazy'} />
                      <div class="hub-event-shade"></div>
                    </div>
                  )}

                  <div class="hub-event-info">
                    <div class="hub-event-topline">
                      <span class:list={['hub-status',event.status==='sales_open'&&'sales',event.status==='sold_out'&&'sold']}>{status(event)}</span>
                      <span class="hub-event-index">{String(index+1).padStart(2,'0')}</span>
                    </div>

                    {!artwork&&(
                      <div class="hub-event-brand" aria-hidden="true">
                        <img src="/brand/gtrz-symbol.svg" alt="" />
                      </div>
                    )}

                    <div class="hub-event-meta">
                      <span>{eventLocation}</span>
                      <span>{formatDate(event.starts_at)} · {formatTime(event.starts_at)}</span>
                    </div>

                    <div class="hub-event-title-row">
                      <h2>{event.title||event.slug}</h2>
                      <span class="hub-event-arrow" aria-hidden="true">↗</span>
                    </div>

                    {event.venue_name&&<p>{event.venue_name}</p>}
                    <div class="hub-event-cta"><span>{copy.view}</span><i></i></div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="hub-empty">
          <img src="/brand/gtrz-symbol.svg" alt="" />
          <div><h2>{copy.emptyTitle}</h2><p>{copy.emptyBody}</p></div>
          <a href={instagram} target="_blank" rel="noreferrer" data-track="hub.empty.instagram">{copy.emptyCta}</a>
        </div>
      )}
    </section>
  </main>

  <footer class="hub-footer hub-shell">
    <img src="/brand/gtrz-wordmark.svg" alt="GTRZ" />
    <span>{copy.footer}</span>
    <a href={instagram} target="_blank" rel="noreferrer" data-track="hub.footer.instagram">@gtrzeventos</a>
  </footer>
</div>

<style>
  .event-hub{
    min-height:100vh;
    overflow:hidden;
    background:
      radial-gradient(circle at 88% 1%,rgba(255,36,26,.10),transparent 23rem),
      linear-gradient(180deg,#080808 0%,#060606 100%);
    color:var(--hub-white)
  }
  .hub-shell{width:calc(100% - 28px);max-width:1320px;margin-inline:auto}

  .hub-header{
    width:calc(100% - 28px);
    max-width:1320px;
    height:68px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    border-bottom:1px solid var(--hub-line)
  }
  .hub-brand{display:flex;align-items:center;min-width:0}
  .hub-brand img{width:88px}
  .hub-nav{display:flex;align-items:center;gap:14px;min-width:0;font-size:.59rem;font-weight:800;letter-spacing:.10em;text-transform:uppercase;color:#8f8884}
  .hub-nav a{white-space:nowrap}
  .hub-nav-events{display:none}
  .hub-nav-instagram{color:#c5bfbb}
  .hub-lang{display:flex;align-items:center;gap:6px;padding-left:12px;border-left:1px solid var(--hub-line)}
  .hub-lang a{color:#5e5956}.hub-lang a.active{color:#fff}.hub-lang span{color:#353230}

  .hub-hero{padding-top:38px}
  .hub-hero-grid{display:grid;grid-template-columns:1fr;gap:26px}
  .hub-eyebrow{display:flex;align-items:center;gap:10px;color:#a9a29e;font-size:.60rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .hub-eyebrow span{width:24px;height:2px;background:var(--hub-red);flex:none}
  .hub-hero h1{
    margin:16px 0 0;
    max-width:100%;
    font-family:'Barlow Condensed','Arial Narrow',sans-serif;
    font-size:clamp(3.75rem,18.5vw,5.6rem);
    font-weight:900;
    line-height:.80;
    letter-spacing:-.038em;
    text-transform:uppercase
  }
  .hub-hero h1 span,.hub-hero h1 strong{display:block}
  .hub-hero h1 strong{color:var(--hub-red);font-weight:900}
  .hub-intro{max-width:32rem}
  .hub-intro p{margin:0;color:#a69e9a;font-size:.94rem;line-height:1.65}
  .hub-scroll{display:inline-flex;align-items:center;gap:12px;margin-top:20px;font-size:.61rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .hub-scroll i{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--hub-line);border-radius:50%;color:var(--hub-red);font-style:normal}

  .hub-marquee{
    width:100%;
    margin-top:40px;
    overflow:hidden;
    padding:11px 0;
    border-top:1px solid var(--hub-line);
    border-bottom:1px solid var(--hub-line);
    color:#514c49;
    font-size:.54rem;
    font-weight:800;
    letter-spacing:.14em;
    white-space:nowrap
  }
  .hub-marquee-track{
    display:flex;
    width:max-content;
    will-change:transform;
    animation:hub-marquee 32s linear infinite
  }
  .hub-marquee-group{
    display:flex;
    align-items:center;
    flex:none;
    width:max-content
  }
  .hub-marquee-group span{
    flex:none;
    padding-left:34px
  }
  @keyframes hub-marquee{to{transform:translateX(-50%)}}

  .hub-events{padding-top:50px;padding-bottom:68px}
  .hub-section-head{display:grid;grid-template-columns:38px minmax(0,1fr);gap:14px;align-items:center;margin-bottom:22px}
  .hub-section-number{
    font-family:'Barlow Condensed','Arial Narrow',sans-serif;
    color:var(--hub-red);
    font-size:1.65rem;
    font-weight:900;
    line-height:1
  }
  .hub-section-label{display:grid;grid-template-columns:auto minmax(30px,1fr);align-items:center;gap:12px;color:#a39c98;font-size:.59rem;font-weight:800;letter-spacing:.12em}
  .hub-section-label span{white-space:nowrap}.hub-section-label i{height:1px;background:var(--hub-line)}

  .hub-event-grid{display:grid;grid-template-columns:1fr;gap:14px}
  .hub-event-card{min-width:0;border:1px solid var(--hub-line);background:#0b0b0b}
  .hub-event-card>a{display:block}
  .hub-event-media{position:relative;aspect-ratio:4/5;overflow:hidden;background:#111}
  .hub-event-media img{width:100%;height:100%;object-fit:cover}
  .hub-event-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.03),transparent 58%,rgba(0,0,0,.34))}
  .hub-event-info{position:relative;padding:15px 14px 19px}
  .hub-event-topline{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}
  .hub-status{display:inline-flex;align-items:center;min-height:27px;padding:0 9px;border:1px solid rgba(255,255,255,.18);color:#d8d2ce;font-size:.53rem;font-weight:800;letter-spacing:.09em;white-space:nowrap}
  .hub-status.sales{background:var(--hub-red);border-color:var(--hub-red);color:#fff}
  .hub-status.sold{background:#fff;border-color:#fff;color:#111}
  .hub-event-index{font-family:'Barlow Condensed','Arial Narrow',sans-serif;color:#817a76;font-size:1.35rem;font-weight:900;line-height:1}
  .hub-event-brand{height:54px;display:flex;align-items:center;margin:-2px 0 18px}
  .hub-event-brand img{width:42px;opacity:.74}
  .hub-event-meta{display:flex;flex-direction:column;gap:5px;color:#817a76;font-size:.57rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}
  .hub-event-title-row{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-top:13px}
  .hub-event-title-row h2{
    margin:0;
    max-width:88%;
    overflow-wrap:anywhere;
    font-family:'Barlow Condensed','Arial Narrow',sans-serif;
    font-size:clamp(2.45rem,13vw,3.7rem);
    font-weight:900;
    line-height:.86;
    letter-spacing:-.025em;
    text-transform:uppercase
  }
  .hub-event-arrow{flex:none;color:var(--hub-red);font-size:1.55rem;line-height:1}
  .hub-event-info p{margin:10px 0 0;color:#918985;font-size:.76rem;line-height:1.45}
  .hub-event-cta{display:flex;align-items:center;gap:10px;margin-top:20px;color:#fff;font-size:.59rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .hub-event-cta i{height:1px;width:34px;background:var(--hub-red)}

  .hub-event-card.no-art{
    background:
      radial-gradient(circle at 78% 15%,rgba(255,36,26,.13),transparent 11rem),
      #0b0b0b
  }
  .hub-event-card.no-art .hub-event-info{min-height:250px;display:flex;flex-direction:column}
  .hub-event-card.no-art .hub-event-meta{margin-top:auto}
  .hub-event-card.no-art .hub-event-topline{margin-bottom:12px}

  .hub-empty{display:grid;gap:22px;padding:25px;border:1px solid var(--hub-line)}
  .hub-empty>img{width:52px;opacity:.72}
  .hub-empty h2{margin:0;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:2.65rem;font-weight:900;line-height:.9;text-transform:uppercase}
  .hub-empty p{margin-bottom:0;color:#938985;line-height:1.55}
  .hub-empty>a{width:max-content;padding:13px 16px;background:var(--hub-red);font-size:.59rem;font-weight:800;letter-spacing:.09em}

  .hub-footer{min-height:86px;border-top:1px solid var(--hub-line);display:grid;grid-template-columns:1fr auto;align-items:center;gap:20px;color:#67615e;font-size:.55rem;font-weight:800;letter-spacing:.10em}
  .hub-footer img{width:76px;opacity:.85}.hub-footer span{display:none}.hub-footer a{color:#99918d}

  @media(min-width:700px){
    .hub-shell,.hub-header,.hub-footer{width:min(calc(100% - 48px),1320px)}
    .hub-header{height:78px}.hub-brand img{width:104px}
    .hub-nav{gap:22px;font-size:.63rem}.hub-nav-events{display:block}.hub-lang{padding-left:20px}
    .hub-hero{padding-top:58px}
    .hub-hero-grid{grid-template-columns:minmax(0,1.35fr) minmax(250px,.65fr);gap:42px;align-items:end}
    .hub-hero h1{font-size:clamp(5.2rem,11vw,8.2rem)}
    .hub-intro{padding-bottom:8px}.hub-intro p{font-size:1rem}
    .hub-marquee{margin-top:60px;font-size:.58rem;padding:12px 0}
    .hub-events{padding-top:68px;padding-bottom:90px}
    .hub-event-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    .hub-event-media{aspect-ratio:16/11}
    .hub-event-info{padding:18px 18px 21px}
    .hub-event-meta{flex-direction:row;justify-content:space-between;gap:16px}
    .hub-event-title-row h2{font-size:clamp(2.9rem,5vw,4.3rem)}
    .hub-event-card.no-art .hub-event-info{min-height:300px}
    .hub-empty{grid-template-columns:70px 1fr auto;align-items:center;padding:32px}
    .hub-footer{grid-template-columns:auto 1fr auto}.hub-footer span{display:block;text-align:center}
  }

  @media(min-width:1100px){
    .hub-header{height:86px}
    .hub-hero{padding-top:72px}
    .hub-hero-grid{grid-template-columns:minmax(0,1.45fr) minmax(280px,.55fr);gap:64px}
    .hub-eyebrow{font-size:.65rem;letter-spacing:.16em}.hub-eyebrow span{width:32px}
    .hub-hero h1{font-size:clamp(6.5rem,9vw,9.2rem);line-height:.82}
    .hub-intro p{font-size:1.05rem}
    .hub-events{padding-top:78px;padding-bottom:100px}
    .hub-section-head{grid-template-columns:58px 1fr;gap:18px;margin-bottom:28px}
    .hub-section-number{font-size:2rem}
    .hub-event-card{transition:transform .2s ease,border-color .2s ease}
    .hub-event-card:hover{transform:translateY(-3px);border-color:rgba(255,255,255,.24)}
    .hub-event-media img{transition:transform .35s ease}.hub-event-card:hover .hub-event-media img{transform:scale(1.015)}
    .hub-event-arrow,.hub-event-cta i{transition:transform .2s ease,width .2s ease}
    .hub-event-card:hover .hub-event-arrow{transform:translate(3px,-3px)}
    .hub-event-card:hover .hub-event-cta i{width:54px}
  }

  @media(max-width:370px){
    .hub-header,.hub-shell,.hub-footer{width:calc(100% - 22px)}
    .hub-brand img{width:80px}
    .hub-nav{gap:10px;font-size:.54rem}.hub-lang{padding-left:9px}
    .hub-hero h1{font-size:clamp(3.4rem,18vw,4.4rem)}
    .hub-event-title-row h2{font-size:2.35rem}
  }

  @media(prefers-reduced-motion:reduce){
    .hub-marquee-track{animation:none}
    .hub-event-card,.hub-event-media img,.hub-event-arrow,.hub-event-cta i{transition:none}
  }
</style>
