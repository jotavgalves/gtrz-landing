---
import type { CmsEvent,Locale,SiteSettings } from '@/lib/cms';
import { API_BASE } from '@/lib/api';

const {events,locale,siteSettings={}}=Astro.props as {events:CmsEvent[];locale:Locale;siteSettings?:SiteSettings};
const es=locale==='es';
const instagram=typeof siteSettings.social?.instagram==='string'&&siteSettings.social.instagram
  ?String(siteSettings.social.instagram)
  :'https://instagram.com/gtrzeventos';
const activeEvents=events.filter(event=>['published','sales_open','sold_out'].includes(event.status)).slice(0,6);

const copy=es?{
  navEvents:'Eventos',
  navInstagram:'Instagram',
  eyebrow:'AGENDA OFICIAL GTRZ',
  titleTop:'PRÓXIMAS',
  titleBottom:'NOCHES.',
  intro:'Cada evento tiene una identidad propia. Elige dónde nos encontramos.',
  listLabel:'PRÓXIMOS EVENTOS',
  view:'VER EVENTO',
  coming:'PRÓXIMAMENTE',
  sales:'ENTRADAS DISPONIBLES',
  sold:'AGOTADO',
  emptyTitle:'NUEVAS FECHAS EN CAMINO.',
  emptyBody:'Sigue a GTRZ para recibir primero los próximos anuncios.',
  emptyCta:'SEGUIR EN INSTAGRAM',
  footer:'GTRZ EVENTOS · CULTURA LATINA EN MOVIMIENTO'
}:{
  navEvents:'Eventos',
  navInstagram:'Instagram',
  eyebrow:'AGENDA OFICIAL GTRZ',
  titleTop:'PRÓXIMAS',
  titleBottom:'NOITES.',
  intro:'Cada evento tem uma identidade própria. Escolha onde a GTRZ te encontra.',
  listLabel:'PRÓXIMOS EVENTOS',
  view:'VER EVENTO',
  coming:'EM BREVE',
  sales:'INGRESSOS DISPONÍVEIS',
  sold:'ESGOTADO',
  emptyTitle:'NOVAS DATAS A CAMINHO.',
  emptyBody:'Acompanhe a GTRZ para receber primeiro os próximos anúncios.',
  emptyCta:'SEGUIR NO INSTAGRAM',
  footer:'GTRZ EVENTOS · CULTURA LATINA EM MOVIMENTO'
};

const parseTheme=(event:CmsEvent)=>{try{return JSON.parse(event.theme_json||'{}')}catch{return {}}};
const posterId=(event:CmsEvent)=>{
  const theme=parseTheme(event);
  return theme.posterMediaId||theme.poster_media_id||event.hero_media_id||null;
};
const mediaUrl=(id?:string|null)=>id?`${API_BASE}/api/media/${encodeURIComponent(id)}`:'';
const formatDate=(iso:string)=>{
  try{
    return new Intl.DateTimeFormat(es?'es-ES':'pt-BR',{day:'2-digit',month:'short'}).format(new Date(iso)).replace('.','').toUpperCase();
  }catch{return ''}
};
const formatTime=(iso:string)=>{
  try{return new Intl.DateTimeFormat(es?'es-ES':'pt-BR',{hour:'2-digit',minute:'2-digit'}).format(new Date(iso))}
  catch{return ''}
};
const status=(event:CmsEvent)=>event.status==='sales_open'?copy.sales:event.status==='sold_out'?copy.sold:copy.coming;
const location=(event:CmsEvent)=>[event.city,event.state].filter(Boolean).join(' · ');
---
<div class="event-hub" id="top">
  <header class="hub-header">
    <a class="hub-brand" href="#top" aria-label="GTRZ Eventos" data-track="hub.logo">
      <img src="/brand/gtrz-wordmark.svg" alt="GTRZ" />
    </a>
    <nav class="hub-nav" aria-label={es?'Navegación':'Navegação'}>
      <a href="#eventos" data-track="hub.nav.events">{copy.navEvents}</a>
      <a href={instagram} target="_blank" rel="noreferrer" data-track="hub.nav.instagram">{copy.navInstagram}</a>
      <div class="hub-lang" aria-label="Idioma">
        <a class:list={{active:!es}} href="?lang=pt-BR" data-track="hub.lang.pt">PT</a>
        <span>/</span>
        <a class:list={{active:es}} href="?lang=es" data-track="hub.lang.es">ES</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hub-hero">
      <div class="hub-hero-grid">
        <div class="hub-hero-copy">
          <div class="hub-eyebrow"><span></span>{copy.eyebrow}</div>
          <h1><span>{copy.titleTop}</span><strong>{copy.titleBottom}</strong></h1>
        </div>
        <div class="hub-intro">
          <p>{copy.intro}</p>
          <a href="#eventos" class="hub-scroll" data-track="hub.hero.events">
            <span>{copy.navEvents}</span>
            <i aria-hidden="true">↓</i>
          </a>
        </div>
      </div>
      <div class="hub-marquee" aria-hidden="true">
        <span>GTRZ · JOÃO PESSOA · RECIFE · LATIN MUSIC · EXPERIÊNCIAS ·</span>
        <span>GTRZ · JOÃO PESSOA · RECIFE · LATIN MUSIC · EXPERIÊNCIAS ·</span>
      </div>
    </section>

    <section class="hub-events" id="eventos" data-section="events">
      <div class="hub-section-head">
        <div class="hub-section-number">01</div>
        <div>
          <span>{copy.listLabel}</span>
          <div class="hub-section-line"></div>
        </div>
      </div>

      {activeEvents.length ? (
        <div class:list={['hub-event-grid',activeEvents.length===1&&'single']}>
          {activeEvents.map((event,index)=>{
            const artwork=mediaUrl(posterId(event));
            const eventLocation=location(event);
            return (
              <article class:list={['hub-event-card',index===0&&'lead']}>
                <a href={`/eventos/${event.slug}?lang=${locale}`} data-track={`hub.event.${event.slug}`} aria-label={`${copy.view}: ${event.title||event.slug}`}>
                  <div class="hub-event-media">
                    {artwork
                      ? <img src={artwork} alt={event.title||event.slug} loading={index===0?'eager':'lazy'} />
                      : <div class="hub-event-fallback"><img src="/brand/gtrz-symbol.svg" alt="" /><span>GTRZ EVENTOS</span></div>}
                    <div class="hub-event-shade"></div>
                    <span class:list={['hub-status',event.status==='sales_open'&&'sales',event.status==='sold_out'&&'sold']}>{status(event)}</span>
                    <div class="hub-event-index">{String(index+1).padStart(2,'0')}</div>
                  </div>
                  <div class="hub-event-info">
                    <div class="hub-event-meta">
                      <span>{eventLocation}</span>
                      <span>{formatDate(event.starts_at)} · {formatTime(event.starts_at)}</span>
                    </div>
                    <div class="hub-event-title-row">
                      <h2>{event.title||event.slug}</h2>
                      <span class="hub-event-arrow" aria-hidden="true">↗</span>
                    </div>
                    {event.venue_name&&<p>{event.venue_name}</p>}
                    <div class="hub-event-cta"><span>{copy.view}</span><i></i></div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="hub-empty">
          <img src="/brand/gtrz-symbol.svg" alt="" />
          <div><h2>{copy.emptyTitle}</h2><p>{copy.emptyBody}</p></div>
          <a href={instagram} target="_blank" rel="noreferrer" data-track="hub.empty.instagram">{copy.emptyCta}</a>
        </div>
      )}
    </section>
  </main>

  <footer class="hub-footer">
    <img src="/brand/gtrz-wordmark.svg" alt="GTRZ" />
    <span>{copy.footer}</span>
    <a href={instagram} target="_blank" rel="noreferrer" data-track="hub.footer.instagram">@gtrzeventos</a>
  </footer>
</div>

<style>
  .event-hub{min-height:100vh;overflow:hidden;background:
    radial-gradient(circle at 82% 4%,rgba(255,36,26,.13),transparent 27rem),
    linear-gradient(180deg,#080808 0%,#060606 100%);color:var(--hub-white)}
  .hub-header{width:min(calc(100% - 64px),1320px);height:92px;margin:auto;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--hub-line)}
  .hub-brand img{width:118px}
  .hub-nav{display:flex;align-items:center;gap:30px;color:#8f8884;font-size:.67rem;font-weight:900;letter-spacing:.11em;text-transform:uppercase}
  .hub-nav>a{transition:color .18s ease}.hub-nav>a:hover{color:#fff}
  .hub-lang{display:flex;align-items:center;gap:7px;border-left:1px solid var(--hub-line);padding-left:28px}
  .hub-lang a{color:#555}.hub-lang a.active{color:#fff}.hub-lang span{color:#363636}
  .hub-hero{padding:clamp(66px,8vw,118px) 0 0}
  .hub-hero-grid{width:min(calc(100% - 64px),1320px);margin:auto;display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.45fr);gap:50px;align-items:end}
  .hub-eyebrow{display:flex;align-items:center;gap:12px;color:#aaa29f;font-size:.68rem;font-weight:900;letter-spacing:.17em}
  .hub-eyebrow span{width:34px;height:2px;background:var(--hub-red)}
  .hub-hero h1{margin:25px 0 0;font-family:Impact,'Arial Narrow',sans-serif;font-size:clamp(5.2rem,11.6vw,10.8rem);font-weight:900;line-height:.78;letter-spacing:-.045em;text-transform:uppercase}
  .hub-hero h1 span,.hub-hero h1 strong{display:block}.hub-hero h1 strong{color:var(--hub-red);font-weight:inherit}
  .hub-intro{padding-bottom:12px}
  .hub-intro p{margin:0 0 35px;color:#a49c98;font-size:clamp(1rem,1.35vw,1.18rem);line-height:1.65}
  .hub-scroll{display:inline-flex;align-items:center;gap:18px;font-size:.68rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  .hub-scroll i{display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--hub-line);border-radius:50%;color:var(--hub-red);font-style:normal}
  .hub-marquee{margin-top:clamp(58px,7vw,96px);display:flex;gap:45px;width:max-content;padding:14px 0;border-top:1px solid var(--hub-line);border-bottom:1px solid var(--hub-line);color:#4f4a48;font-size:.62rem;font-weight:900;letter-spacing:.18em;white-space:nowrap;animation:hub-marquee 28s linear infinite}
  .hub-marquee span{padding-left:45px}
  @keyframes hub-marquee{to{transform:translateX(-50%)}}
  .hub-events{width:min(calc(100% - 64px),1320px);margin:auto;padding:88px 0 112px}
  .hub-section-head{display:grid;grid-template-columns:70px 1fr;gap:20px;align-items:end;margin-bottom:34px}
  .hub-section-number{color:var(--hub-red);font-family:Impact,'Arial Narrow',sans-serif;font-size:2.2rem}
  .hub-section-head>div:last-child{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:20px;color:#a49c98;font-size:.65rem;font-weight:900;letter-spacing:.15em}
  .hub-section-line{height:1px;background:var(--hub-line)}
  .hub-event-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .hub-event-grid.single{grid-template-columns:minmax(0,760px)}
  .hub-event-card{min-width:0;border:1px solid var(--hub-line);background:#0b0b0b;transition:transform .24s ease,border-color .24s ease}
  .hub-event-card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,.25)}
  .hub-event-card>a{display:block}
  .hub-event-media{position:relative;aspect-ratio:16/10;overflow:hidden;background:#101010}
  .hub-event-media>img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
  .hub-event-card:hover .hub-event-media>img{transform:scale(1.025)}
  .hub-event-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),transparent 52%,rgba(0,0,0,.58))}
  .hub-status{position:absolute;left:18px;top:18px;padding:9px 12px;border:1px solid rgba(255,255,255,.23);background:rgba(8,8,8,.76);backdrop-filter:blur(12px);font-size:.58rem;font-weight:950;letter-spacing:.1em}
  .hub-status.sales{border-color:rgba(255,36,26,.65);background:rgba(255,36,26,.9)}.hub-status.sold{background:#fff;color:#111}
  .hub-event-index{position:absolute;right:18px;top:15px;color:rgba(255,255,255,.56);font-family:Impact,'Arial Narrow',sans-serif;font-size:1.5rem}
  .hub-event-fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:18px;background:radial-gradient(circle at center,rgba(255,36,26,.18),transparent 38%),#0b0b0b}
  .hub-event-fallback img{width:80px;opacity:.82}.hub-event-fallback span{color:#5b5552;font-size:.58rem;font-weight:900;letter-spacing:.18em}
  .hub-event-info{padding:22px 22px 24px}
  .hub-event-meta{display:flex;justify-content:space-between;gap:18px;color:#817a76;font-size:.62rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .hub-event-title-row{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-top:22px}
  .hub-event-title-row h2{margin:0;max-width:82%;font-family:Impact,'Arial Narrow',sans-serif;font-size:clamp(2.7rem,5vw,4.7rem);line-height:.88;letter-spacing:-.035em;text-transform:uppercase}
  .hub-event-arrow{color:var(--hub-red);font-size:1.9rem;transition:transform .2s ease}.hub-event-card:hover .hub-event-arrow{transform:translate(3px,-3px)}
  .hub-event-info p{margin:12px 0 0;color:#8e8581;font-size:.82rem}
  .hub-event-cta{display:flex;align-items:center;gap:12px;margin-top:25px;color:#fff;font-size:.63rem;font-weight:950;letter-spacing:.13em}
  .hub-event-cta i{height:1px;width:42px;background:var(--hub-red);transition:width .2s ease}.hub-event-card:hover .hub-event-cta i{width:72px}
  .hub-empty{min-height:300px;border:1px solid var(--hub-line);display:grid;grid-template-columns:100px 1fr auto;gap:35px;align-items:center;padding:40px}
  .hub-empty>img{width:78px;opacity:.7}.hub-empty h2{margin:0;font-family:Impact,'Arial Narrow',sans-serif;font-size:3.4rem}.hub-empty p{color:#938985}
  .hub-empty>a{padding:15px 20px;background:var(--hub-red);font-size:.64rem;font-weight:950;letter-spacing:.1em}
  .hub-footer{width:min(calc(100% - 64px),1320px);margin:auto;min-height:105px;border-top:1px solid var(--hub-line);display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:28px;color:#5e5855;font-size:.58rem;font-weight:900;letter-spacing:.12em}
  .hub-footer img{width:86px;opacity:.82}.hub-footer span{text-align:center}.hub-footer a{color:#8b8380}
  @media(max-width:900px){
    .hub-hero-grid{grid-template-columns:1fr}.hub-intro{max-width:560px}.hub-event-grid{grid-template-columns:1fr}
    .hub-event-media{aspect-ratio:16/9}.hub-footer{grid-template-columns:auto 1fr}.hub-footer span{display:none}
  }
  @media(max-width:640px){
    .hub-header,.hub-hero-grid,.hub-events,.hub-footer{width:calc(100% - 28px)}
    .hub-header{height:72px}.hub-brand img{width:92px}.hub-nav{gap:15px}.hub-nav>a:first-child{display:none}.hub-nav{font-size:.58rem}.hub-lang{padding-left:14px}
    .hub-hero{padding-top:52px}.hub-hero h1{font-size:clamp(4.35rem,22vw,7rem)}
    .hub-intro p{font-size:.98rem}.hub-marquee{margin-top:52px}
    .hub-events{padding:58px 0 78px}.hub-section-head{grid-template-columns:44px 1fr;margin-bottom:24px}.hub-section-number{font-size:1.65rem}
    .hub-event-media{aspect-ratio:4/3}.hub-status{left:12px;top:12px;padding:7px 9px;font-size:.5rem}.hub-event-index{right:12px;top:10px}
    .hub-event-info{padding:17px 15px 20px}.hub-event-meta{flex-direction:column;gap:5px;font-size:.56rem}.hub-event-title-row{margin-top:15px}
    .hub-event-title-row h2{font-size:clamp(2.7rem,15vw,4rem)}.hub-event-info p{font-size:.76rem}
    .hub-empty{grid-template-columns:1fr;padding:26px}.hub-empty h2{font-size:2.7rem}
    .hub-footer{min-height:92px;grid-template-columns:1fr auto}.hub-footer img{width:78px}
  }
  @media(prefers-reduced-motion:reduce){.hub-marquee{animation:none}.hub-event-card,.hub-event-media>img,.hub-event-arrow,.hub-event-cta i{transition:none}}
</style>
