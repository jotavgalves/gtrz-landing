---
import type { CmsEvent, Locale, SiteSettings } from '@/lib/cms';
import { API_BASE } from '@/lib/api';
import { getPublicCopy } from '@/lib/public-copy';

const { events, locale, siteSettings = {} } = Astro.props as { events: CmsEvent[]; locale: Locale; siteSettings?: SiteSettings };
const settings=siteSettings.event_popup||{};
const c=getPublicCopy(siteSettings,locale,'popup');
const isEs=locale==='es';
const forcePreview=Astro.url.searchParams.get('popup')==='1';
const enabled = forcePreview || settings.enabled !== false;
const publicEvents = events.filter(event => ['published','sales_open','sold_out'].includes(event.status));
const selectedEvent = settings.selectedEventId ? publicEvents.find(event => event.id === settings.selectedEventId) : undefined;
const eventPool = selectedEvent ? [selectedEvent] : publicEvents;
const activeEvents = eventPool.slice(0, Math.max(1, Math.min(6, Number(settings.maxEvents) || 4)));
const frequency = forcePreview ? 'always' : (settings.frequency || 'session');
const delayMs = forcePreview ? 80 : Math.max(0, Math.min(15000, Number(settings.delayMs ?? 700)));
const single=activeEvents.length===1;
const cityCount=new Set(activeEvents.map(event=>`${event.city||''}|${event.state||''}`.toLowerCase())).size;
const eventCount=activeEvents.length;
const multiMeta=isEs
  ? `${cityCount} ${cityCount===1?'CIUDAD':'CIUDADES'} · ${eventCount} ${eventCount===1?'EVENTO':'EVENTOS'}`
  : `${cityCount} ${cityCount===1?'CIDADE':'CIDADES'} · ${eventCount} ${eventCount===1?'EVENTO':'EVENTOS'}`;

const ui=isEs?{
  kicker:'AGENDA GTRZ', titleTop:'LA PRÓXIMA NOCHE GTRZ', titleBottom:'YA TIENE FECHA.', multiTop:'PRÓXIMAS NOCHES GTRZ.', multiBottom:'ELIGE LA TUYA.',
  body:'Conoce la próxima edición.', multiBody:'Elige ciudad y descubre la próxima edición.',
  from:'Desde', view:'VER EVENTO', sold:'AGOTADO', continue:'Continuar en el sitio', venue:'LUGAR', coming:'PRÓXIMAMENTE', available:'ENTRADAS DISPONIBLES'
}:{
  kicker:'AGENDA GTRZ', titleTop:'A PRÓXIMA NOITE GTRZ', titleBottom:'JÁ TEM DATA.', multiTop:'PRÓXIMAS NOITES GTRZ.', multiBottom:'ESCOLHA A SUA.',
  body:'Confira a próxima edição.', multiBody:'Escolha a cidade e descubra a próxima edição.',
  from:'A partir de', view:'VER EVENTO', sold:'ESGOTADO', continue:'Continuar no site', venue:'LOCAL', coming:'EM BREVE', available:'INGRESSOS DISPONÍVEIS'
};

const parseTheme=(event:CmsEvent)=>{try{return JSON.parse(event.theme_json||'{}')}catch{return {}}};
const mediaId=(event:CmsEvent)=>{const theme=parseTheme(event);return theme.posterMediaId||theme.poster_media_id||event.hero_media_id||null};
const mediaUrl=(id?:string|null)=>id?`${API_BASE}/api/media/${encodeURIComponent(id)}`:'';
const shortDate=(event:CmsEvent)=>new Intl.DateTimeFormat(isEs?'es-ES':'pt-BR',{day:'2-digit',month:'short'}).format(new Date(event.starts_at)).replace('.','').toUpperCase();
const shortTime=(event:CmsEvent)=>{const value=new Intl.DateTimeFormat('pt-BR',{hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(event.starts_at));return value.endsWith(':00')?`${value.slice(0,2)}H`:value};
const price=(event:CmsEvent)=>event.min_price_cents==null?'':new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:Number(event.min_price_cents)%100===0?0:2}).format(Number(event.min_price_cents)/100);
const location=(event:CmsEvent)=>event.venue_name||[event.city,event.state].filter(Boolean).join(' · ');
const cityLabel=(event:CmsEvent)=>[event.city,event.state].filter(Boolean).join(' · ');
const statusText=(event:CmsEvent)=>event.status==='sales_open'?ui.available:event.status==='sold_out'?ui.sold:ui.coming;
const safeColor=(v:any,fallback:string)=>/^#[0-9a-f]{6}$/i.test(String(v||''))?String(v):fallback;
const clamp=(v:any,min:number,max:number,fallback:number)=>{const n=Number(v);return Number.isFinite(n)?Math.max(min,Math.min(max,n)):fallback};
---
{enabled && activeEvents.length > 0 && <div class="event-popup popup-v2" data-event-popup hidden aria-hidden="true">
  <div class:list={["event-popup-card",single?'is-single':'is-multiple']} role="dialog" aria-modal="true" aria-labelledby="eventPopupTitle">
    <div class="popup-head">
      <div class="popup-head-brand"><img src="/brand/gtrz-symbol.svg" alt=""/><small>{ui.kicker}</small></div>
      <button class="popup-close" type="button" aria-label={c.closeLabel} data-popup-close><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15"/></svg></button>
    </div>
    <div class="popup-layout">
      <div class="popup-copy">
        {single?<div class="popup-city"><i></i>{cityLabel(activeEvents[0])}</div>:<div class="popup-multi-meta"><i></i>{multiMeta}</div>}
        <h2 class="display" id="eventPopupTitle">{single?<>{ui.titleTop}<br/><span class="red">{ui.titleBottom}</span></>:<>{ui.multiTop}<br/><span class="red">{ui.multiBottom}</span></>}</h2>
        <p>{single?ui.body:ui.multiBody}</p>
        <button class="popup-continue" type="button" data-popup-close>{ui.continue}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></button>
      </div>
      <div class:list={["popup-events",single?'single-event':'multiple-events']}>
        {activeEvents.map(event => {
          const artwork=mediaUrl(mediaId(event));
          const theme=parseTheme(event);
          const titleDesign=theme.posterTitle||{};
          const titleMode=titleDesign.mode==='artwork'?'artwork':'text';
          const titleText=String(titleDesign.text||event.title||event.slug);
          const titleColor=safeColor(titleDesign.color,'#fffdf8');
          const glowEnabled=titleDesign.glowEnabled===true;
          const glowColor=safeColor(titleDesign.glowColor,titleColor);
          const glowBlur=clamp(titleDesign.glowBlur,0,48,18);
          const glowOpacity=clamp(titleDesign.glowOpacity,0,1,.7);
          const scale=clamp(titleDesign.scale,50,180,100);
          const titleArtwork=mediaUrl(titleDesign.artworkMediaId||null);
          const fontId=titleDesign.fontMediaId||null;
          const fontName=`GTRZPopupTitle_${String(event.id).replace(/[^a-zA-Z0-9_]/g,'')}`;
          const textShadow=glowEnabled?`0 0 ${glowBlur}px color-mix(in srgb, ${glowColor} ${Math.round(glowOpacity*100)}%, transparent)`:undefined;
          const titleNode=titleMode==='artwork'&&titleArtwork
            ? <img class="popup-custom-title-art" src={titleArtwork} alt={event.title||event.slug} style={`--popup-title-scale:${scale/100};${glowEnabled?`filter:drop-shadow(0 0 ${glowBlur}px ${glowColor});`:''}`} />
            : <strong class="popup-custom-title-text" style={`font-family:${fontId?`"${fontName}"`:'inherit'};color:${titleColor};text-shadow:${textShadow||'none'};--popup-title-scale:${scale/100}`}>{titleText}</strong>;
          return <a class="popup-event-option" href={`/eventos/${event.slug}?lang=${locale}`} data-track={`popup.event.${event.slug}`} data-track-event="popup_click">
            {fontId&&<style is:inline>{`@font-face{font-family:"${fontName}";src:url("${mediaUrl(fontId)}");font-display:swap}`}</style>}
            <div class:list={["popup-event-media",artwork?'has-art':'no-art']}>
              {artwork?<img src={artwork} alt={event.title||event.slug} loading="eager"/>:<div class="popup-fallback-title">{titleNode}</div>}
              <div class="popup-event-media-shade"></div>
              <span class:list={["popup-ticket-status",event.status==='sales_open'?'open':event.status==='sold_out'?'sold':'coming']}>{statusText(event)}</span>
            </div>
            <div class="popup-event-content">
              <span class="popup-event-city-inline">{cityLabel(event)}</span>
              <div class="popup-event-date"><span>{shortDate(event)}</span><span>{shortTime(event)}</span></div>
              {artwork&&<div class="popup-content-title">{titleNode}</div>}
              <div class="popup-event-place"><small>{ui.venue}</small><b>{location(event)}</b></div>
              <div class="popup-event-footer">
                <div>{event.status==='sales_open'&&price(event)?<><small>{ui.from}</small><b>{price(event)}</b></>:<span></span>}</div>
                <span class="popup-event-cta">{ui.view}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></span>
              </div>
            </div>
          </a>;
        })}
      </div>
    </div>
  </div>
</div>}
<style>
.popup-v2 .is-multiple{width:min(1080px,calc(100vw - 40px))}
.popup-v2 .is-multiple .popup-layout{grid-template-columns:minmax(240px,.48fr) minmax(0,1.52fr);gap:24px;padding:22px 26px 26px}
.popup-v2 .is-multiple .popup-copy h2{font-size:clamp(2.45rem,3.55vw,3.55rem);line-height:.88;max-width:330px}
.popup-v2 .is-multiple .popup-copy>p{font-size:.82rem;max-width:300px;margin-top:13px}
.popup-v2 .multiple-events{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.popup-v2 .popup-event-option{border-radius:18px!important;background:#0d0d0d!important}
.popup-v2 .is-multiple .popup-event-media{aspect-ratio:4/5;min-height:0!important}
.popup-v2 .popup-event-media.has-art>img{object-fit:cover}
.popup-v2 .popup-event-media.no-art{aspect-ratio:4/5;min-height:0!important;background:linear-gradient(155deg,#17100f,#090909 65%,#050505)}
.popup-v2 .popup-fallback-title{position:absolute;inset:auto 16px 18px;z-index:1;display:flex;align-items:flex-end;min-width:0}
.popup-v2 .popup-custom-title-text{display:block;max-width:100%;font-family:var(--font-display,"Arial Narrow",Impact,sans-serif);font-size:clamp(2rem,3vw,3rem);font-weight:900;line-height:.85;text-transform:uppercase;transform:scale(var(--popup-title-scale,1));transform-origin:left bottom}
.popup-v2 .popup-custom-title-art{display:block!important;width:auto!important;height:auto!important;max-width:92%!important;max-height:105px!important;object-fit:contain!important;object-position:left bottom!important;transform:scale(var(--popup-title-scale,1));transform-origin:left bottom}
.popup-v2 .popup-content-title{display:flex;align-items:center;min-height:44px;margin-top:7px;overflow:visible}
.popup-v2 .popup-content-title .popup-custom-title-text{font-size:1.65rem}
.popup-v2 .popup-content-title .popup-custom-title-art{max-height:58px!important;max-width:95%!important}
.popup-v2 .popup-ticket-status{position:absolute;z-index:4;top:12px;left:12px;padding:6px 8px;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:rgba(7,7,7,.74);backdrop-filter:blur(8px);font-size:.46rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
.popup-v2 .popup-ticket-status:before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;margin-right:6px;background:#ffb02e;box-shadow:0 0 10px rgba(255,176,46,.55)}
.popup-v2 .popup-ticket-status.open:before{background:#4bdd86;box-shadow:0 0 10px rgba(75,221,134,.55)}
.popup-v2 .popup-ticket-status.sold:before{background:#8a8a8a;box-shadow:none}
.popup-v2 .is-multiple .popup-event-content{padding:14px 15px 15px}
.popup-v2 .is-multiple .popup-event-city-inline{display:inline-flex;margin-bottom:8px;background:transparent;border:0;padding:0;color:#ff6a63}
.popup-v2 .popup-event-cta{background:transparent;border:1px solid rgba(255,255,255,.2);padding:7px 10px;color:#fff}
.popup-v2 .popup-event-option:hover .popup-event-cta{border-color:#ff332a;background:#ff2118}
.popup-v2 .popup-event-footer{align-items:center}
@media(max-width:900px){.popup-v2 .is-multiple .popup-layout{grid-template-columns:1fr;gap:14px}.popup-v2 .is-multiple .popup-copy h2{max-width:none;font-size:clamp(2.3rem,8vw,3.4rem)}.popup-v2 .is-multiple .popup-copy>p{max-width:none}.popup-v2 .multiple-events{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.popup-v2 .is-multiple .popup-layout{padding:13px}.popup-v2 .popup-copy>p{display:none}.popup-v2 .popup-continue{margin-top:8px}.popup-v2 .multiple-events{grid-template-columns:1fr}.popup-v2 .popup-event-option{display:grid!important;grid-template-columns:112px 1fr}.popup-v2 .is-multiple .popup-event-media{aspect-ratio:auto;height:100%;min-height:160px!important}.popup-v2 .popup-event-content{min-height:160px}.popup-v2 .popup-event-place{display:grid!important}.popup-v2 .popup-event-footer{margin-top:auto}.popup-v2 .popup-ticket-status{top:8px;left:8px;font-size:.42rem;padding:5px 6px}.popup-v2 .popup-custom-title-art{max-height:62px!important}.popup-v2 .popup-custom-title-text{font-size:1.35rem}.popup-v2 .popup-content-title .popup-custom-title-text{font-size:1.35rem}.popup-v2 .popup-content-title .popup-custom-title-art{max-height:48px!important}}
</style>
<script define:vars={{ frequency, delayMs }}>
  const popup = document.querySelector('[data-event-popup]');
  const key = 'gtrz_event_popup_seen';
  const today = new Date().toISOString().slice(0,10);
  const storageRead = (kind, storageKey) => { try { const storage = kind === 'local' ? window.localStorage : window.sessionStorage; return storage.getItem(storageKey); } catch { return null; } };
  const storageWrite = (kind, storageKey, value) => { try { const storage = kind === 'local' ? window.localStorage : window.sessionStorage; storage.setItem(storageKey,value); } catch {} };
  const handoff = storageRead('session','gtrz_language_handoff') === '1';
  if (handoff) { try { sessionStorage.removeItem('gtrz_language_handoff'); } catch {} }
  const seen = handoff ? false : frequency === 'always' ? false : frequency === 'day' ? storageRead('local',key) === today : storageRead('session',key) === '1';
  const markSeen = () => { if (frequency === 'day') storageWrite('local',key,today); else if (frequency !== 'always') storageWrite('session',key,'1'); };
  const track = (name) => { try { window.gtrzTrack?.(name,{section:'event_popup'}); } catch {} };
  const clearHandoff = () => document.documentElement.classList.remove('gtrz-popup-handoff');
  const closePopup = () => { if (!popup) return; popup.hidden=true; popup.setAttribute('hidden',''); popup.setAttribute('aria-hidden','true'); document.body.classList.remove('modal-open'); clearHandoff(); track('popup_close'); };
  const openPopup = () => { if (!popup) { clearHandoff(); return; } const languageGate = document.querySelector('[data-language-gate]'); if (languageGate && !languageGate.hidden) return; popup.hidden=false; popup.removeAttribute('hidden'); popup.setAttribute('aria-hidden','false'); document.body.classList.add('modal-open'); clearHandoff(); markSeen(); track('popup_view'); };
  const schedulePopup = () => { if (!popup || seen) { clearHandoff(); return; } const languageGate = document.querySelector('[data-language-gate]'); if (languageGate && !languageGate.hidden) return; window.setTimeout(openPopup,handoff?0:delayMs); };
  schedulePopup();
  popup?.querySelectorAll('[data-popup-close]').forEach(button=>button.addEventListener('click',closePopup));
  popup?.addEventListener('click',(event)=>{ if(event.target===popup) closePopup(); });
  addEventListener('keydown',(event)=>{if(event.key==='Escape'&&!popup?.hidden)closePopup()});
  window.setTimeout(clearHandoff,1800);
</script>
