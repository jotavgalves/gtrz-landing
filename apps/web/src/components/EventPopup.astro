---
import type { CmsEvent, Locale, SiteSettings } from '@/lib/cms';
import { getPublicCopy } from '@/lib/public-copy';
const { events, locale, siteSettings = {} } = Astro.props as { events: CmsEvent[]; locale: Locale; siteSettings?: SiteSettings };
const settings=siteSettings.event_popup||{};
const c=getPublicCopy(siteSettings,locale,'popup');
const enabled = settings.enabled !== false;
const selected = settings.selectedEventId ? events.filter(event => event.id === settings.selectedEventId) : events;
const activeEvents = selected.filter(event => ['published','sales_open','sold_out'].includes(event.status)).slice(0, Math.max(1, Math.min(6, settings.maxEvents || 4)));
const frequency = settings.frequency || 'session';
const delayMs = Math.max(0, Math.min(15000, Number(settings.delayMs ?? 700)));
---
{enabled && activeEvents.length > 0 && <div class="event-popup" data-event-popup hidden aria-hidden="true">
  <div class="event-popup-card" role="dialog" aria-modal="true" aria-labelledby="eventPopupTitle">
    <div class="popup-head"><div class="popup-head-brand"><img src="/brand/gtrz-symbol.svg" alt=""/><small>{activeEvents.length > 1 ? c.multiHeader : c.singleHeader}</small></div><button class="popup-close" type="button" aria-label={c.closeLabel} data-popup-close>×</button></div>
    <div class="popup-body">
      <div class="eyebrow">{c.eyebrow}</div>
      {activeEvents.length === 1 && <div class="city-pill">{activeEvents[0].city}{activeEvents[0].state ? ` · ${activeEvents[0].state}` : ''}</div>}
      <h2 class="display" id="eventPopupTitle">{activeEvents.length > 1 ? <>{c.multiTitleLine1}<br/>{c.multiTitleLine2} <span class="red">{c.multiTitleAccent}</span></> : <>{c.singleTitleLine1}<br/>{c.singleTitleLine2} <span class="red">{c.singleTitleAccent}</span></>}</h2>
      <p>{activeEvents.length > 1 ? c.multiBody : (activeEvents[0]?.summary || c.singleFallbackBody)}</p>
      <div class="popup-events">{activeEvents.map(event => <a class="popup-event-option" href={`/eventos/${event.slug}?lang=${locale}`} data-track={`popup.event.${event.slug}`} data-track-event="popup_click"><span class="city-pill">{event.city}{event.state ? ` · ${event.state}` : ''}</span><strong>{event.title || event.slug}</strong><small>{event.status === 'sold_out' ? c.soldOutLabel : c.eventCta}</small></a>)}</div>
      <button class="popup-continue" type="button" data-popup-close>{c.continueLabel}</button>
    </div>
  </div>
</div>}
<script define:vars={{ frequency, delayMs }}>
  const popup = document.querySelector('[data-event-popup]');
  const key = 'gtrz_event_popup_seen';
  const today = new Date().toISOString().slice(0,10);
  const seen = frequency === 'always' ? false : frequency === 'day' ? localStorage.getItem(key) === today : sessionStorage.getItem(key) === '1';
  const markSeen = () => { if (frequency === 'day') localStorage.setItem(key,today); else if (frequency !== 'always') sessionStorage.setItem(key,'1'); };
  const closePopup = () => { if (!popup) return; popup.hidden=true; popup.setAttribute('aria-hidden','true'); document.body.classList.remove('modal-open'); window.gtrzTrack?.('popup_close',{section:'event_popup'}); };
  if (popup && !seen) setTimeout(()=>{ popup.hidden=false; popup.setAttribute('aria-hidden','false'); document.body.classList.add('modal-open'); markSeen(); window.gtrzTrack?.('popup_view',{section:'event_popup'}); },delayMs);
  popup?.querySelectorAll('[data-popup-close]').forEach(button=>button.addEventListener('click',closePopup));
  popup?.addEventListener('click',(event)=>{ if(event.target===popup) closePopup(); });
</script>
