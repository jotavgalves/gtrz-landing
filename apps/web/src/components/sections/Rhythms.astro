---
import { defaultContent } from '@/lib/default-content';const {locale,content={}}=Astro.props;const es=locale==='es';const defaults=defaultContent(locale).rhythms;const items=Array.isArray(content.items)?content.items:defaults;const c={eyebrow:es?'El sonido de GTRZ':'O som da GTRZ',title:es?'NUESTROS RITMOS.':'NOSSOS RITMOS.',body:es?'Nuestra pista nace del encuentro entre ritmos latinos, urbanos y brasileños.':'Nossa pista nasce do encontro entre ritmos latinos, urbanos e brasileiros.',...content};
---
<section id="ritmos" class="dark-section" data-section="rhythms"><div class="shell"><div class="section-head"><div><span class="eyebrow">{c.eyebrow}</span><h2>{c.title}</h2></div><p>{c.body}</p></div><div class="rhythm-grid">{items.map((item:any,index:number)=><article><small>{String(index+1).padStart(2,'0')}</small><strong>{typeof item==='string'?item:item.name}</strong>{typeof item==='object'&&item.body&&<span>{item.body}</span>}</article>)}</div></div></section>
