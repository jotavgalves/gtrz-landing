---
import { defaultContent } from '@/lib/default-content';
const {locale,content={}}=Astro.props;
const es=locale==='es';
const defaults=defaultContent(locale).rhythms;
const items=Array.isArray(content.items)?content.items:defaults;
const c={eyebrow:es?'El sonido de GTRZ':'O som da GTRZ',title:es?'NUESTROS RITMOS.':'NOSSOS RITMOS.',body:es?'Nuestra pista nace del encuentro entre ritmos latinos, urbanos y brasileños.':'Nossa pista nasce do encontro entre ritmos latinos, urbanos e brasileiros.',...content};
---
<section id="ritmos" class="rhythms" data-section="rhythms">
  <div class="wrap">
    <div class="section-head reveal"><div><div class="eyebrow">{c.eyebrow}</div><h2 class="display">{c.title}</h2></div><p>{c.body}</p></div>
    <div class="rhythm-grid">{items.map((item:any,index:number)=><article class="rhythm-card reveal"><small>{String(index+1).padStart(2,'0')}</small><strong>{typeof item==='string'?item:item.name}</strong>{typeof item==='object'&&item.body&&<span>{item.body}</span>}</article>)}</div>
  </div>
</section>
