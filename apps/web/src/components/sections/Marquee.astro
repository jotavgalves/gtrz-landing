---
const { locale='pt-BR', content={} } = Astro.props as { locale?:'pt-BR'|'es'; content?:Record<string,any> };
const defaults=locale==='es'?['GTRZ EVENTOS','RECIFE','JOÃO PESSOA','CULTURA LATINA','EXPERIENCIAS','PRODUCCIÓN']:['GTRZ EVENTOS','RECIFE','JOÃO PESSOA','CULTURA LATINA','EXPERIÊNCIAS','PRODUÇÃO'];
const source=Array.isArray(content.marqueeItems)&&content.marqueeItems.length?content.marqueeItems:defaults;
const items=source.map((item:any)=>String(typeof item==='string'?item:item?.name||'').trim()).filter(Boolean);
const duration=Math.max(22,Math.min(48,items.length*4.4));
---
<div class="runner runner-v2" aria-label={locale==='es'?'Temas de GTRZ':'Temas da GTRZ'} style={`--runner-duration:${duration}s`}>
  <div class="runner-track">
    {[0,1,2,3].map(copy=><div class="runner-group" aria-hidden={copy===0?undefined:'true'}>
      {items.map((item:string)=><span><b>{item}</b><i aria-hidden="true"></i></span>)}
    </div>)}
  </div>
</div>
<style>
.runner-v2{width:100%;height:34px;overflow:hidden;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.06);background:#0a0a0a;white-space:nowrap;contain:paint;display:flex;align-items:center}
.runner-v2 .runner-track{display:flex;width:max-content;will-change:transform;animation:runner-loop var(--runner-duration,28s) linear infinite}
.runner-v2 .runner-group{display:flex;flex:0 0 auto;align-items:center}
.runner-v2 .runner-group span{display:flex;align-items:center;flex:0 0 auto;gap:18px;padding:0 18px 0 0;color:#716a67;font-size:.58rem;font-weight:900;line-height:1;letter-spacing:.095em;text-transform:uppercase}
.runner-v2 .runner-group span::before,.runner-v2 .runner-group span::after{content:none!important;display:none!important}
.runner-v2 .runner-group span b{font:inherit;white-space:nowrap}
.runner-v2 .runner-group span i{display:block;flex:0 0 auto;width:3px;height:3px;border-radius:50%;background:var(--red,#ff1a12);box-shadow:0 0 6px rgba(255,26,18,.28)}
@keyframes runner-loop{to{transform:translate3d(-25%,0,0)}}
@media(max-width:700px){.runner-v2{height:31px}.runner-v2 .runner-group span{gap:15px;padding-right:15px;font-size:.55rem;letter-spacing:.085em}.runner-v2 .runner-group span i{width:3px;height:3px}}
@media(prefers-reduced-motion:reduce){.runner-v2 .runner-track{animation-duration:70s}}
</style>
