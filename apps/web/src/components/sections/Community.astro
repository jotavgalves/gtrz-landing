---
const { locale } = Astro.props;
const es = locale === 'es';
---
<section id="quem" class="dark-section" data-section="team"><div class="shell"><div class="section-head"><div><span class="eyebrow">{es?'Quién hace que suceda':'Quem faz acontecer'}</span><h2>{es?'POR DETRÁS DE GTRZ.':'POR TRÁS DA GTRZ.'}</h2></div><p>{es?'Personas reales construyendo cada experiencia.':'Pessoas reais construindo cada experiência.'}</p></div><div class="feature-grid"><article><small>GTRZ</small><h3>{es?'Venezolanos + brasileños':'Venezuelanos + brasileiros'}</h3><p>{es?'Una construcción conjunta entre culturas.':'Uma construção conjunta entre culturas.'}</p></article><article id="trabalhe"><small>FREELANCERS</small><h3>{es?'Trabaja con nosotros':'Trabalhe com a gente'}</h3><p>{es?'Forma parte de nuestra base para futuras producciones.':'Faça parte do nosso banco para futuras produções.'}</p><a href="/trabalhe-conosco" data-track="freelancers.open">{es?'Registrarme':'Quero me cadastrar'}</a></article><article id="parcerias"><small>{es?'ALIANZAS':'PARCERIAS'}</small><h3>{es?'Construyamos algo juntos':'Vamos construir juntos'}</h3><p>{es?'Marcas, espacios, artistas y proveedores.':'Marcas, casas, artistas e fornecedores.'}</p><a href="/parcerias" data-track="partnerships.open">{es?'Proponer alianza':'Propor parceria'}</a></article></div></div></section>
