---
import { defaultContent } from '@/lib/default-content';
import type { Locale } from '@/lib/cms';
const { locale, content = {} } = Astro.props as { locale: Locale; content?: Record<string, unknown> };
const defaults = defaultContent(locale).hero;
const es = locale === 'es';
const c: Record<string, any> = {
  ...defaults,
  primaryCta: es ? 'Ver eventos' : 'Ver eventos',
  secondaryCta: es ? 'Conocer GTRZ' : 'Conhecer a GTRZ',
  originEyebrow: es ? 'DE VENEZUELA A BRASIL' : 'DA VENEZUELA PARA O BRASIL',
  routeFrom: 'VENEZUELA',
  routeTo: 'BRASIL',
  ...content
};
function splitDisplay(value: unknown, fallbackAccentWords = 1) {
  const text = String(value || '').trim();
  const sentences = text.match(/[^.!?]+[.!?]?/g)?.map((part) => part.trim()).filter(Boolean) || [];
  if (sentences.length >= 2) {
    return { lead: sentences.slice(0, -1).join(' '), accent: sentences.at(-1) || '' };
  }
  const words = text.split(/\s+/).filter(Boolean);
  const accent = words.splice(Math.max(0, words.length - fallbackAccentWords)).join(' ');
  return { lead: words.join(' '), accent };
}
const titleDisplay = splitDisplay(c.title, 1);
const originDisplay = splitDisplay(c.originTitle, 2);
---
<section id="top" class="hero" data-section="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy reveal">
      <div class="eyebrow">{c.eyebrow}</div>
      <h1 class="display"><span class="hero-title-lead">{titleDisplay.lead}</span> <span class="red hero-title-accent">{titleDisplay.accent}</span></h1>
      <p>{c.body}</p>
      <div class="hero-actions">
        <a class="btn btn-red" href="#eventos" data-track="hero.events">{c.primaryCta}</a>
        <a class="btn" href="#sobre" data-track="hero.about">{c.secondaryCta}</a>
      </div>
    </div>
    <aside class="hero-side reveal">
      <img class="hero-side-logo" src="/brand/gtrz-full.svg" alt="GTRZ Eventos" />
      <div class="hero-origin">
        <small>{c.originEyebrow}</small>
        <strong><span>{originDisplay.lead}</span><br/><span class="red">{originDisplay.accent}</span></strong>
        <p>{c.originBody}</p>
      </div>
      <div class="hero-origin-route"><span>{c.routeFrom}</span><i></i><span>{c.routeTo}</span></div>
    </aside>
  </div>
</section>
