---
import type { CmsEvent,Locale } from '@/lib/cms';const {events,locale,content={}}=Astro.props as {events:CmsEvent[];locale:Locale;content?:Record<string,any>};const es=locale==='es';const c={eyebrow:'Agenda GTRZ',title:'EVENTOS.',body:es?'Cada proyecto tiene identidad propia. Entra para ver lugar, line-up y entradas.':'Cada projeto tem identidade própria. Entre para ver local, line-up e ingressos.',emptyTitle:es?'Nuevos eventos en preparación.':'Novos eventos em preparação.',emptyBody:es?'Síguenos en Instagram para recibir las próximas fechas.':'Siga a GTRZ no Instagram para receber as próximas datas.',...content};
---
<section id="eventos" class="events-section" data-section="events"><div class="shell"><div class="section-head"><div><span class="eyebrow">{c.eyebrow}</span><h2>{c.title}</h2></div><p>{c.body}</p></div>{events.length?<div class="event-grid">{events.map(event=><a class="event-card" href={`/eventos/${event.slug}`} data-track={`events.${event.slug}`}><span>{event.city}{event.state?` · ${event.state}`:''}</span><h3>{event.title||event.slug}</h3><small>{event.status==='sales_open'?(es?'VENTAS ABIERTAS':'VENDAS ABERTAS'):event.status.toUpperCase()}</small></a>)}</div>:<div class="empty-state"><strong>{c.emptyTitle}</strong><p>{c.emptyBody}</p></div>}</div></section>
