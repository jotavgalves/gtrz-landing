---
const {locale,content={}}=Astro.props as {locale:'pt-BR'|'es';content:Record<string,any>};
const es=locale==='es';
const c={eyebrow:es?'Marcas · Espacios · Artistas · Proveedores':'Marcas · Casas · Artistas · Fornecedores',title:es?'ALIANZAS QUE TIENEN SENTIDO.':'PARCERIAS QUE FAZEM SENTIDO.',body:es?'GTRZ está abierta a colaboraciones que sumen experiencia para el público y valor para ambas partes.':'A GTRZ está aberta a colaborações que agreguem experiência para o público e valor para os dois lados.',cta:es?'Proponer una alianza':'Propor uma parceria',...content};
---
<section id="parcerias" class="dark-section partnership-section" data-section="partnerships">
  <div class="shell people-cta-grid">
    <div><span class="eyebrow">{c.eyebrow}</span><h2>{c.title}</h2></div>
    <div class="people-cta-copy"><p>{c.body}</p><div class="partnership-types"><div><strong>{es?'Espacios':'Casas e espaços'}</strong><span>{es?'Recibir producciones GTRZ.':'Receber produções GTRZ.'}</span></div><div><strong>{es?'Marcas':'Marcas'}</strong><span>{es?'Patrocinios y activaciones.':'Patrocínios e ativações.'}</span></div><div><strong>{es?'Artistas':'Artistas'}</strong><span>{es?'Line-ups y proyectos culturales.':'Line-ups e projetos culturais.'}</span></div><div><strong>{es?'Proveedores':'Fornecedores'}</strong><span>{es?'Operación, estructura y servicios.':'Operação, estrutura e serviços.'}</span></div></div><a class="button primary" href={`/parcerias?lang=${locale}`} data-track="partnerships.open">{c.cta}</a></div>
  </div>
</section>
