---
const {locale,content={}}=Astro.props;const es=locale==='es';const c={eyebrow:es?'Síguenos de cerca':'Acompanhe de perto',title:es?'SIGUE A GTRZ EN INSTAGRAM.':'SIGA A GTRZ NO INSTAGRAM.',body:es?'Nuevos eventos, backstage, line-ups, lotes y registros de las fiestas.':'Novos eventos, bastidores, line-ups, lotes e registros das festas.',handle:'@gtrzeventos',url:'https://instagram.com/gtrzeventos',...content};
---
<section id="instagram" class="instagram-section" data-section="instagram"><div class="shell instagram-card"><div><span class="eyebrow">{c.eyebrow}</span><h2>{c.title}</h2><p>{c.body}</p><strong>{c.handle}</strong><div class="actions"><a class="button primary" href={c.url} rel="noopener" target="_blank" data-track="instagram.follow">{es?'Seguir en Instagram':'Seguir no Instagram'}</a></div></div><div class="instagram-mark"><img src="/brand/gtrz-wordmark.svg" alt=""/><span>{c.handle}</span></div></div></section>
