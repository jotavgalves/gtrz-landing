---
const {locale,content={}}=Astro.props;
const es=locale==='es';
const c={
  eyebrow:es?'Sobre la GTRZ':'Sobre a GTRZ',
  title:es?'LA FIESTA TIENE IDENTIDAD.':'A FESTA TEM IDENTIDADE.',
  body1:es?'GTRZ crea fiestas y experiencias con personalidad propia para una comunidad latina diversa. En la misma pista conviven referencias, ritmos y públicos de Colombia, Argentina, Venezuela, Cuba, Brasil y mucho más.':'A GTRZ cria festas e experiências com personalidade própria para uma comunidade latina diversa. Na mesma pista convivem referências, ritmos e públicos da Colômbia, Argentina, Venezuela, Cuba, Brasil e muito mais.',
  body2:es?'Cada edición se piensa de punta a punta: concepto, música, dirección visual, comunicación y operación. La idea no es repetir una fórmula, sino darle a cada noche una razón real para existir.':'Cada edição é pensada de ponta a ponta: conceito, música, direção visual, comunicação e operação. A ideia não é repetir uma fórmula, mas dar a cada noite uma razão real para existir.',
  note:es?'NO HACEMOS FIESTAS EN SERIE. CADA EDICIÓN NECESITA CONCEPTO, RITMO Y PRESENCIA.':'NÃO FAZEMOS FESTAS EM SÉRIE. CADA EDIÇÃO PRECISA DE CONCEITO, RITMO E PRESENÇA.',
  metric1Value:es?'COMUNIDAD LATINA REAL':'COMUNIDADE LATINA REAL',metric1Label:es?'Públicos diversos, referencias compartidas y una pista hecha para conectar personas.':'Públicos diversos, referências compartilhadas e uma pista feita para conectar pessoas.',
  metric2Value:es?'CURADURÍA MUSICAL':'CURADORIA MUSICAL',metric2Label:es?'Reggaeton, salsa, merengue, bachata, funk y mezclas urbanas entran según la energía de cada edición.':'Reggaeton, salsa, merengue, bachata, funk e misturas urbanas entram conforme a energia de cada edição.',
  metric3Value:'PT + ES',metric3Label:es?'Portugués y español conviven de forma natural antes, durante y después del evento.':'Português e espanhol convivem de forma natural antes, durante e depois do evento.',
  metric4Value:es?'DEL CONCEPTO A LA OPERACIÓN':'DO CONCEITO À OPERAÇÃO',metric4Label:es?'Visual, ingreso, line-up, ambientación y experiencia se piensan como un todo.':'Visual, entrada, line-up, ambientação e experiência são pensados como um todo.',
  ...content
};
const titleParts=String(c.title).trim().split(/\s+/);const accent=titleParts.pop()||'';const lead=titleParts.join(' ');
const proofs=[
  [c.metric1Value,c.metric1Label],
  [c.metric2Value,c.metric2Label],
  [c.metric3Value,c.metric3Label],
  [c.metric4Value,c.metric4Label]
];
---
<section id="sobre" class="about about-editorial" data-section="about">
  <div class="wrap">
    <div class="about-editorial-grid">
      <div class="about-title-block reveal">
        <div class="eyebrow about-eyebrow">{c.eyebrow}<span aria-hidden="true"></span></div>
        <h2 class="display">{lead} <span class="red">{accent}</span></h2>
      </div>
      <div class="about-copy about-copy-editorial reveal">
        <p class="about-lead">{c.body1}</p>
        <p>{c.body2}</p>
      </div>
    </div>

    <div class="about-signature reveal"><span>{c.note}</span></div>

    <div class="about-proof-grid" aria-label={es?'Lo que define a GTRZ':'O que define a GTRZ'}>
      {proofs.map(([title,body],index)=><article class="about-proof reveal">
        <small>{String(index+1).padStart(2,'0')}</small>
        <h3>{title}</h3>
        <p>{body}</p>
      </article>)}
    </div>
  </div>
</section>
